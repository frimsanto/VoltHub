import { createFileRoute } from "@tanstack/react-router";
import { PageHeader } from "@/components/common";
import { Card, CardContent } from "@/components/ui/card";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { Badge } from "@/components/ui/badge";
import { Switch } from "@/components/ui/switch";
import { Dialog, DialogContent, DialogHeader, DialogTitle } from "@/components/ui/dialog";
import { Building2, Plus, Search, Pencil, Trash2, Loader2, FileX } from "lucide-react";
import { useState, useEffect } from "react";
import { showSuccessAuto, showError, showConfirm } from "@/lib/swal";
import { requireRole } from "@/lib/route-guards";
import { getRtupps, createRtupp, updateRtupp, deleteRtupp, type Rtupp } from "@/lib/api/rtupp";

export const Route = createFileRoute("/_app/rtupp")({
  beforeLoad: () => {
    requireRole(["superadmin"]);
  },
  component: Rtupp,
  head: () => ({ meta: [{ title: "RTUPP Management — VoltReport" }] }),
});

type RtuppForm = {
  code: string;
  name: string;
  region: string;
  address: string;
  phone: string;
  isActive: boolean;
};

const emptyForm: RtuppForm = {
  code: "",
  name: "",
  region: "",
  address: "",
  phone: "",
  isActive: true,
};

function Rtupp() {
  const [q, setQ] = useState("");
  const [rtupps, setRtupps] = useState<Rtupp[]>([]);
  const [loading, setLoading] = useState(false);
  const [saving, setSaving] = useState(false);
  const [dialogOpen, setDialogOpen] = useState(false);
  const [editing, setEditing] = useState<Rtupp | null>(null);
  const [form, setForm] = useState<RtuppForm>(emptyForm);

  const filtered = rtupps.filter(
    (r) =>
      q === "" ||
      r.name.toLowerCase().includes(q.toLowerCase()) ||
      r.code.toLowerCase().includes(q.toLowerCase()) ||
      (r.region ?? "").toLowerCase().includes(q.toLowerCase()),
  );

  const fetchRtupps = async () => {
    setLoading(true);
    try {
      const data = await getRtupps();
      setRtupps(data);
    } catch (error) {
      console.error("Failed to fetch RTUPP:", error);
      showError("Error", "Gagal mengambil data RTUPP");
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    fetchRtupps();
  }, []);

  const openCreate = () => {
    setEditing(null);
    setForm(emptyForm);
    setDialogOpen(true);
  };

  const openEdit = (r: Rtupp) => {
    setEditing(r);
    setForm({
      code: r.code,
      name: r.name,
      region: r.region ?? "",
      address: r.address ?? "",
      phone: r.phone ?? "",
      isActive: r.isActive,
    });
    setDialogOpen(true);
  };

  const handleSave = async () => {
    if (!form.code.trim() || !form.name.trim()) {
      showError("Validasi", "Kode dan nama RTUPP wajib diisi");
      return;
    }

    setSaving(true);
    try {
      const payload = {
        code: form.code.trim(),
        name: form.name.trim(),
        region: form.region.trim() || undefined,
        address: form.address.trim() || undefined,
        phone: form.phone.trim() || undefined,
        isActive: form.isActive,
      };

      if (editing) {
        await updateRtupp(editing.id, payload);
        showSuccessAuto("Berhasil", "RTUPP berhasil diperbarui", 1200);
      } else {
        await createRtupp(payload);
        showSuccessAuto("Berhasil", "RTUPP berhasil ditambahkan", 1200);
      }
      setDialogOpen(false);
      setEditing(null);
      setForm(emptyForm);
      fetchRtupps();
    } catch (error: any) {
      showError("Error", error.message || "Gagal menyimpan RTUPP");
    } finally {
      setSaving(false);
    }
  };

  const handleDelete = async (r: Rtupp) => {
    const confirmed = await showConfirm(
      "Hapus RTUPP",
      `Apakah Anda yakin ingin menghapus RTUPP "${r.name}"? Tindakan ini tidak dapat dibatalkan.`,
    );
    if (!confirmed.isConfirmed) return;

    try {
      await deleteRtupp(r.id);
      showSuccessAuto("Berhasil", "RTUPP berhasil dihapus", 1200);
      fetchRtupps();
    } catch (error: any) {
      showError("Error", error.message || "Gagal menghapus RTUPP");
    }
  };

  return (
    <div className="space-y-6">
      <PageHeader
        title="RTUPP Management"
        description="Kelola unit pelayanan dan area kerja."
        actions={
          <Button className="rounded-xl gradient-pln text-white" onClick={openCreate}>
            <Plus className="size-4 mr-2" /> Tambah RTUPP
          </Button>
        }
      />

      <Card className="rounded-2xl shadow-soft border-border/60">
        <CardContent className="p-4 flex flex-wrap items-center gap-3">
          <div className="relative flex-1 min-w-[220px]">
            <Search className="size-4 absolute left-3 top-1/2 -translate-y-1/2 text-muted-foreground" />
            <Input
              placeholder="Cari kode, nama, atau region..."
              value={q}
              onChange={(e) => setQ(e.target.value)}
              className="pl-9 rounded-xl"
            />
          </div>
          <Badge variant="secondary" className="ml-auto rounded-full">
            {filtered.length} RTUPP
          </Badge>
        </CardContent>
      </Card>

      <Card className="rounded-2xl shadow-soft border-border/60 overflow-hidden">
        {loading ? (
          <div className="flex items-center justify-center py-12">
            <Loader2 className="size-8 animate-spin text-muted-foreground" />
          </div>
        ) : filtered.length === 0 ? (
          <CardContent className="p-12">
            <div className="flex flex-col items-center justify-center text-center">
              <FileX className="size-16 text-muted-foreground mb-4" />
              <div className="text-lg font-semibold">Belum ada data RTUPP</div>
              <div className="text-sm text-muted-foreground mt-2 max-w-md">
                {q
                  ? "Tidak ada RTUPP yang cocok dengan pencarian."
                  : "Silakan tambahkan RTUPP baru untuk memulai."}
              </div>
            </div>
          </CardContent>
        ) : (
          <div className="overflow-x-auto">
            <table className="w-full text-sm">
              <thead className="bg-muted/50 text-xs uppercase tracking-wider text-muted-foreground">
                <tr>
                  <th className="text-left px-4 py-3 font-semibold">Kode</th>
                  <th className="text-left px-4 py-3 font-semibold">Nama</th>
                  <th className="text-left px-4 py-3 font-semibold">Region</th>
                  <th className="text-left px-4 py-3 font-semibold">Telepon</th>
                  <th className="text-left px-4 py-3 font-semibold">Team</th>
                  <th className="text-left px-4 py-3 font-semibold">User</th>
                  <th className="text-left px-4 py-3 font-semibold">Status</th>
                  <th className="text-right px-4 py-3 font-semibold">Aksi</th>
                </tr>
              </thead>
              <tbody>
                {filtered.map((r) => (
                  <tr key={r.id} className="border-t border-border/60 hover:bg-muted/30">
                    <td className="px-4 py-3">
                      <div className="flex items-center gap-2">
                        <Building2 className="size-4 text-pln-blue" />
                        <span className="font-medium">{r.code}</span>
                      </div>
                    </td>
                    <td className="px-4 py-3">{r.name}</td>
                    <td className="px-4 py-3 text-muted-foreground text-xs">{r.region || "-"}</td>
                    <td className="px-4 py-3 text-muted-foreground text-xs">{r.phone || "-"}</td>
                    <td className="px-4 py-3 text-muted-foreground text-xs">
                      {r._count?.teams ?? 0}
                    </td>
                    <td className="px-4 py-3 text-muted-foreground text-xs">
                      {r._count?.users ?? 0}
                    </td>
                    <td className="px-4 py-3">
                      <Badge
                        variant={r.isActive ? "default" : "secondary"}
                        className="rounded-full"
                      >
                        {r.isActive ? "Aktif" : "Nonaktif"}
                      </Badge>
                    </td>
                    <td className="px-4 py-3 text-right">
                      <Button
                        size="sm"
                        variant="ghost"
                        className="rounded-lg"
                        aria-label={`Edit RTUPP ${r.name}`}
                        onClick={() => openEdit(r)}
                      >
                        <Pencil className="size-4" />
                      </Button>
                      <Button
                        size="sm"
                        variant="ghost"
                        className="rounded-lg text-destructive"
                        aria-label={`Hapus RTUPP ${r.name}`}
                        onClick={() => handleDelete(r)}
                      >
                        <Trash2 className="size-4" />
                      </Button>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </Card>

      <Dialog open={dialogOpen} onOpenChange={setDialogOpen}>
        <DialogContent>
          <DialogHeader>
            <DialogTitle>{editing ? "Edit RTUPP" : "Tambah RTUPP Baru"}</DialogTitle>
          </DialogHeader>
          <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <Label>Kode</Label>
              <Input
                value={form.code}
                onChange={(e) => setForm({ ...form, code: e.target.value })}
                className="rounded-xl mt-1.5"
                placeholder="RTUPP-01"
              />
            </div>
            <div>
              <Label>Nama</Label>
              <Input
                value={form.name}
                onChange={(e) => setForm({ ...form, name: e.target.value })}
                className="rounded-xl mt-1.5"
                placeholder="Nama RTUPP"
              />
            </div>
            <div>
              <Label>Region</Label>
              <Input
                value={form.region}
                onChange={(e) => setForm({ ...form, region: e.target.value })}
                className="rounded-xl mt-1.5"
                placeholder="Wilayah"
              />
            </div>
            <div>
              <Label>Telepon</Label>
              <Input
                value={form.phone}
                onChange={(e) => setForm({ ...form, phone: e.target.value })}
                className="rounded-xl mt-1.5"
                placeholder="08xxxxxxxxxx"
              />
            </div>
            <div className="col-span-1 sm:col-span-2">
              <Label>Alamat</Label>
              <Input
                value={form.address}
                onChange={(e) => setForm({ ...form, address: e.target.value })}
                className="rounded-xl mt-1.5"
                placeholder="Alamat lengkap"
              />
            </div>
            <div className="col-span-1 sm:col-span-2 flex items-center justify-between rounded-xl border border-border/60 px-3 py-2">
              <Label className="cursor-pointer">Status Aktif</Label>
              <Switch
                checked={form.isActive}
                onCheckedChange={(v) => setForm({ ...form, isActive: v })}
              />
            </div>
          </div>
          <Button
            className="rounded-xl gradient-pln text-white mt-2"
            onClick={handleSave}
            disabled={saving}
          >
            {saving ? (
              <>
                <Loader2 className="size-4 mr-2 animate-spin" /> Menyimpan...
              </>
            ) : (
              "Simpan"
            )}
          </Button>
        </DialogContent>
      </Dialog>
    </div>
  );
}
