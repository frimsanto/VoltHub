# ─────────────────────────────────────────────────────────────────────────────
# VoltReport Frontend — ENVIRONMENT (development template)
# Copy to `.env` (Vite reads it). Only VITE_* vars are exposed to the client —
# never put secrets here; everything is shipped to the browser.
# ─────────────────────────────────────────────────────────────────────────────

# Backend API base URL (include the /api prefix).
VITE_API_URL=http://localhost:3001/api
VITE_API_TIMEOUT=30000

# Sentry (frontend error monitoring) — empty disables Sentry.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_RELEASE=voltreport-frontend@1.0.0
VITE_SENTRY_TRACES_SAMPLE_RATE=0

# Source-map upload to Sentry happens at BUILD time only (not committed, not in
# the client bundle). These are build-host env vars (CI secrets), NOT VITE_*:
#   SENTRY_ORG=...
#   SENTRY_PROJECT=...
#   SENTRY_AUTH_TOKEN=...

# Push notifications (Capacitor). Leave EMPTY/false until an FCM project is
# provisioned (android/app/google-services.json) — enabling it without Firebase
# crashes the Android app when notification permission is granted.
VITE_PUSH_ENABLED=false

# VoltHub AI — the in-app assistant's Groq key now lives on the BACKEND only
# (BE/.env → GROQ_API_KEY). The browser calls POST /api/v1/ai/groq-proxy, so no
# Groq key belongs in the client bundle. Nothing to set here.
