# ─────────────────────────────────────────────────────────────────────────────
# VoltReport Frontend — PRODUCTION template (build-time env)
# Provide these when building the production bundle. VITE_* are public — no
# secrets here (everything ships to the browser).
# ─────────────────────────────────────────────────────────────────────────────

VITE_API_URL=https://voltreport.pln.co.id/api
VITE_API_TIMEOUT=30000

VITE_SENTRY_DSN=<PROD_FRONTEND_SENTRY_DSN>
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_RELEASE=voltreport-frontend@1.0.0
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# Build-host secrets for source-map upload (NOT VITE_*, injected by CI):
#   SENTRY_ORG=...
#   SENTRY_PROJECT=...
#   SENTRY_AUTH_TOKEN=...

# Push notifications — keep false until google-services.json is shipped.
VITE_PUSH_ENABLED=false
