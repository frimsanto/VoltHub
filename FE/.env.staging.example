# ─────────────────────────────────────────────────────────────────────────────
# VoltReport Frontend — STAGING template (build-time env)
# Provide these when building the staging bundle. VITE_* are public.
# ─────────────────────────────────────────────────────────────────────────────

VITE_API_URL=https://staging.voltreport.pln.co.id/api
VITE_API_TIMEOUT=30000

VITE_SENTRY_DSN=<STAGING_FRONTEND_SENTRY_DSN>
VITE_SENTRY_ENVIRONMENT=staging
VITE_SENTRY_RELEASE=voltreport-frontend@1.0.0
VITE_SENTRY_TRACES_SAMPLE_RATE=0.2

# Build-host secrets for source-map upload (NOT VITE_*, injected by CI):
#   SENTRY_ORG=...
#   SENTRY_PROJECT=...
#   SENTRY_AUTH_TOKEN=...
