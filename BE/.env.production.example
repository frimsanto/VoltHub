# ─────────────────────────────────────────────────────────────────────────────
# VoltReport Backend — PRODUCTION template
# Copy to `.env` on the production host (or inject via secret manager). Values
# marked <…> MUST be replaced with real, strong secrets. NEVER commit `.env`.
#
# The server runs validateProductionEnv() on boot and WILL REFUSE TO START if:
#   - JWT_SECRET / JWT_REFRESH_SECRET are weak (< 32 chars) or a known default
#   - JWT_SECRET == JWT_REFRESH_SECRET
#   - DATABASE_URL is empty
#   - CORS_ORIGIN is "*"
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=3001
API_PREFIX=/api
LOG_LEVEL=warn

# Database — production MySQL with a least-privilege app user.
DATABASE_URL="mysql://voltreport:<STRONG_DB_PASSWORD>@db-prod.internal:3306/voltreport"

# JWT — REQUIRED strong, distinct secrets. Generate with:
#   openssl rand -base64 48
JWT_SECRET=<PROD_ACCESS_SECRET_min_32_chars>
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=<PROD_REFRESH_SECRET_min_32_chars_distinct>
JWT_REFRESH_EXPIRES_IN=30d

# CORS — the real production frontend origin. Must NOT be "*".
CORS_ORIGIN=https://voltreport.pln.co.id

# Uploads
MAX_FILE_SIZE=26214400
MAX_FILES_PER_UPLOAD=20
UPLOAD_DIR=uploads

# Rate limiting (tune to expected production traffic)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# App version gate — bump APP_MIN_VERSION to force-update broken native clients.
APP_MIN_VERSION=1.0.0
APP_LATEST_VERSION=1.0.0
APP_UPDATE_URL_ANDROID=https://play.google.com/store/apps/details?id=id.pln.voltreport
APP_UPDATE_URL_IOS=https://apps.apple.com/app/voltreport

# Push (Firebase Cloud Messaging)
FCM_SERVER_KEY=<PROD_FCM_SERVER_KEY>

# Sentry — production environment, lower trace sample rate to control volume.
SENTRY_DSN=<PROD_SENTRY_DSN>
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=voltreport-backend@1.0.0
SENTRY_TRACES_SAMPLE_RATE=0.1

# Backups — point at an off-server / replicated volume.
BACKUP_ROOT=/var/backups/voltreport
RETAIN_DAILY=7
RETAIN_WEEKLY=30
RETAIN_MONTHLY=90
