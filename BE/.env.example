# ─────────────────────────────────────────────────────────────────────────────
# VoltReport Backend — ENVIRONMENT (development template)
# Copy to `.env` and adjust. NEVER commit a real `.env`.
# For staging/production use .env.staging.example / .env.production.example.
# ─────────────────────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
PORT=3001
API_PREFIX=/api
LOG_LEVEL=debug

# Database (MySQL)
DATABASE_URL="mysql://root:@localhost:3306/voltreport?schema=public&connect_timeout=60"

# JWT — dev defaults are fine locally. In production these MUST be strong
# (>= 32 chars, distinct) or the server refuses to boot (validateProductionEnv).
JWT_SECRET=dev-access-secret-change-me-0123456789
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-0123456789
JWT_REFRESH_EXPIRES_IN=30d

# CORS — the frontend origin allowed to call this API.
CORS_ORIGIN=http://localhost:5173

# Uploads
MAX_FILE_SIZE=26214400          # 25 MB (bytes)
MAX_FILES_PER_UPLOAD=20
UPLOAD_DIR=uploads

# Rate limiting (general API limiter)
RATE_LIMIT_WINDOW_MS=900000     # 15 min
RATE_LIMIT_MAX_REQUESTS=100

# App version gate (force-update for native clients)
APP_MIN_VERSION=1.0.0
APP_LATEST_VERSION=1.0.0
APP_UPDATE_URL_ANDROID=https://play.google.com/store/apps/details?id=id.pln.voltreport
APP_UPDATE_URL_IOS=https://apps.apple.com/app/voltreport

# Push (Firebase Cloud Messaging) — empty disables push sending.
FCM_SERVER_KEY=

# AI Assistant (Claude). Empty ANTHROPIC_API_KEY disables the LLM; the assistant
# then falls back to the frontend's deterministic engine. Data is only sent to
# Anthropic when a key is present. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-4-8

# Groq (llama-3.3) — powers the FAB assistant via POST /api/v1/ai/groq-proxy.
# The key lives here on the backend ONLY (never shipped in the client bundle).
# Empty ⇒ the proxy returns 503 and the FAB shows its honest preview mode.
# Get a key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions

# Sentry (error monitoring) — empty DSN disables Sentry entirely.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=voltreport-backend@1.0.0
SENTRY_TRACES_SAMPLE_RATE=0

# Backups (used by scripts/backup.sh). Defaults to BE/backups if unset.
# BACKUP_ROOT=/var/backups/voltreport
# RETAIN_DAILY=7
# RETAIN_WEEKLY=30
# RETAIN_MONTHLY=90
