model Asset {
  id            String      @id @default(uuid()) @db.VarChar(36)
  locationId    String      @db.VarChar(36)
  feederId      String?     @db.VarChar(36)
  bayId         String?     @db.VarChar(36) // ADDITIVE: GI → Bay → Asset
  parentAssetId String?     @db.VarChar(36)
  assetTypeId   String?     @db.VarChar(36)
  assetType     AssetType
  assetCode     String      @unique(map: "uq_asset_code") @db.VarChar(100)
  assetName     String      @db.VarChar(255)
  brand         String?     @db.VarChar(150)
  model         String?     @db.VarChar(150)
  serialNumber  String?     @unique(map: "uq_asset_serial") @db.VarChar(150)
  tahunOperasi  Int?
  status        AssetStatus @default(ACTIVE)
  notes         String?

  // RTU specific
  protocol    String? @db.VarChar(100)
  asdu        String? @db.VarChar(100)
  linkAddress String? @db.VarChar(100)
  pairChannel String? @db.VarChar(100)
  masterIp1   String? @db.VarChar(50)
  masterIp2   String? @db.VarChar(50)

  // Live SCADA state (ADDITIVE — fed by periodic IFS export ingestion).
  // Deliberately SEPARATE from `status` (the asset lifecycle enum): `status`
  // describes the asset's registry state (ACTIVE/DAMAGED/…) and is edited by
  // humans, whereas these describe the *current communication state* reported
  // by the master station and are overwritten on every import (snapshot, not
  // history — the time-series of changes lives in telemetry_values).
  // `scadaRtuName` is the stable correlation key to the SCADA `RTU Name`.
  scadaRtuName       String?   @db.VarChar(100)
  operState          String?   @db.VarChar(20) // UP / DOWN
  adminState         String?   @db.VarChar(20) // ON / OFF
  commLastSeenAt     DateTime? @db.Timestamptz(0) // last export this RTU appeared in
  commStateChangedAt DateTime? @db.Timestamptz(0) // when operState last transitioned

  // Battery specific
  batteryCount Int?
  capacity     String? @db.VarChar(100)

  createdAt DateTime  @default(now()) @db.Timestamptz(0)
  updatedAt DateTime  @default(now()) @updatedAt @db.Timestamptz(0)
  createdBy String?   @db.VarChar(36)
  updatedBy String?   @db.VarChar(36)
  deletedAt DateTime? @db.Timestamptz(0)

  location     Location       @relation(fields: [locationId], references: [id], onUpdate: Restrict, map: "assets_location_fk")
  feeder       Feeder?        @relation(fields: [feederId], references: [id], onUpdate: Restrict, map: "assets_feeder_fk")
  bay          Bay?           @relation(fields: [bayId], references: [id], onUpdate: Restrict, map: "assets_bay_fk")
  parentAsset  Asset?         @relation("AssetHierarchy", fields: [parentAssetId], references: [id], onUpdate: Restrict, map: "assets_parent_fk")
  children     Asset[]        @relation("AssetHierarchy")
  workOrders   WorkOrder[]
  laporanHarGi LaporanHarGi[]
  simCards     AssetSimCard[]
  // V2 additive: bridge to taxonomy reference table (legacy `assetType` enum kept)
  assetTypeRef AssetTypeRef?  @relation(fields: [assetTypeId], references: [id], onUpdate: Restrict, map: "assets_asset_type_fk")

  inspectionFindings InspectionFinding[]
  inspectionPhotos   InspectionPhoto[]
  harDetails         HarDetail[]
  documents          Document[]

  @@index([assetType], map: "idx_assets_type")
  @@index([locationId], map: "idx_assets_location")
  @@index([feederId], map: "idx_assets_feeder")
  @@index([bayId], map: "idx_assets_bay")
  @@index([parentAssetId], map: "idx_assets_parent")
  @@index([status], map: "idx_assets_status")
  @@index([assetTypeId], map: "idx_assets_asset_type")
  // Live monitoring: correlation key for SCADA ingestion + filtering DOWN RTUs.
  @@index([scadaRtuName], map: "idx_assets_scada_rtu_name")
  @@index([operState], map: "idx_assets_oper_state")
  @@map("assets")
}

