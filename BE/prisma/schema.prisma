/// Digital Signature for a generated report (Digital Signature module).
/// Ed25519-signed, QR-embedded, offline-verifiable proof of authenticity &
/// integrity. One immutable signature per generated artifact. The compact
/// `token` (payload.signature) is what the QR encodes; `contentHash` is the
/// signed semantic digest, `fileHash` the rendered-bytes digest for tamper
/// detection. Spec: docs/DIGITAL_SIGNATURE.md.
model ReportSignature {
  id           String @id @default(uuid()) @db.VarChar(36)
  reportId     String @unique @db.VarChar(36)
  reportNumber String @db.VarChar(100)
  sourceType   String @db.VarChar(30)
  sourceId     String @db.VarChar(36)
  version      Int    @default(1)

  algorithm   String @default("Ed25519") @db.VarChar(20)
  keyId       String @db.VarChar(64)
  contentHash String @db.VarChar(64)
  fileHash    String @db.VarChar(64)
  signature   String
  payload     String
  token       String
  verifyUrl   String

  issuer     String  @db.VarChar(255)
  signedBy   String? @db.VarChar(36)
  signerName String? @db.VarChar(150)

  // Lifecycle. VALID until explicitly revoked (e.g. superseded / erroneous).
  status        String    @default("VALID") @db.VarChar(20)
  revokedAt     DateTime? @db.Timestamptz(0)
  revokedBy     String?   @db.VarChar(36)
  revokedReason String?   @db.VarChar(255)

  // Verification telemetry.
  verifyCount    Int       @default(0)
  lastVerifiedAt DateTime? @db.Timestamptz(0)

  signedAt DateTime @default(now()) @db.Timestamptz(0)

  report GeneratedReport @relation(fields: [reportId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "report_signatures_report_fk")

  @@index([reportNumber], map: "idx_report_signatures_number")
  @@index([sourceType, sourceId], map: "idx_report_signatures_source")
  @@index([status], map: "idx_report_signatures_status")
  @@map("report_signatures")
}

/// Download-history audit trail for generated reports (who fetched what, when).
model ReportDownload {
  id           String   @id @default(uuid()) @db.VarChar(36)
  reportId     String   @db.VarChar(36)
  downloadedBy String?  @db.VarChar(36)
  ipAddress    String?  @db.VarChar(45)
  downloadedAt DateTime @default(now()) @db.Timestamptz(0)

  report GeneratedReport @relation(fields: [reportId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "report_downloads_report_fk")

  @@index([reportId], map: "idx_report_downloads_report")
  @@index([downloadedAt], map: "idx_report_downloads_at")
  @@map("report_downloads")
}

