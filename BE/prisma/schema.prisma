// ============================================================
// VoltHub V2 — Gardu-Centric Domain (Phase 1, ADDITIVE)
// Source of truth: docs/05_ERD.md, docs/10_DATA_DICTIONARY.md,
// docs/11_BUSINESS_RULES.md.
//
// MySQL in-place, additive only: NO table renamed or dropped.
// New operational tables (performance_daily, tickets, site_geometries,
// telemetry_*) attach to the existing `locations` table — the current
// de-facto Gardu/Site store. The physical column `locationId` here is
// the future `site_id`; it is renamed when locations→sites in the
// full-restructure phase. The legacy `UserRole` / `AssetType` enums are
// intentionally retained (36 files depend on them) so the build stays
// green; the approved roles live in the new `roles` table and the asset
// taxonomy lives in `asset_categories`/`asset_types`. Enum→table cutover
// is deferred to the controller-migration phase.
// ============================================================

model Organization {
  id        String   @id @default(uuid()) @db.VarChar(36)
  code      String   @unique(map: "uq_organization_code") @db.VarChar(50)
  name      String   @db.VarChar(255)
  createdAt DateTime @default(now()) @db.Timestamptz(0)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(0)

  rtupps RTUPP[]

  @@index([code], map: "idx_organizations_code")
  @@map("organizations")
}

model Up3 {
  id        String   @id @default(uuid()) @db.VarChar(36)
  rtuppId   String   @db.VarChar(36)
  code      String   @db.VarChar(50)
  name      String   @db.VarChar(255)
  createdAt DateTime @default(now()) @db.Timestamptz(0)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(0)

  rtupp RTUPP @relation(fields: [rtuppId], references: [id], onUpdate: Restrict, map: "up3s_rtupp_fk")

  @@unique([rtuppId, code], map: "uq_up3_rtupp_code")
  @@index([rtuppId], map: "idx_up3s_rtupp")
  @@map("up3s")
}

// Approved roles (docs/07): SUPER_ADMIN, ADMIN, PETUGAS — seeded as rows.
model Role {
  id          String   @id @default(uuid()) @db.VarChar(36)
  name        String   @unique(map: "uq_role_name") @db.VarChar(50)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @db.Timestamptz(0)
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz(0)

  users User[]

  @@map("roles")
}

model AssetCategory {
  id          String   @id @default(uuid()) @db.VarChar(36)
  name        String   @unique(map: "uq_asset_category_name") @db.VarChar(100)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @db.Timestamptz(0)
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz(0)

  assetTypes AssetTypeRef[]

  @@map("asset_categories")
}

// Named *Ref to avoid collision with the existing `AssetType` enum.
model AssetTypeRef {
  id              String   @id @default(uuid()) @db.VarChar(36)
  assetCategoryId String   @db.VarChar(36)
  name            String   @db.VarChar(100)
  description     String?  @db.VarChar(255)
  createdAt       DateTime @default(now()) @db.Timestamptz(0)
  updatedAt       DateTime @default(now()) @updatedAt @db.Timestamptz(0)

  category AssetCategory @relation(fields: [assetCategoryId], references: [id], onUpdate: Restrict, map: "asset_types_category_fk")
  assets   Asset[]

  @@unique([assetCategoryId, name], map: "uq_asset_type_category_name")
  @@index([assetCategoryId], map: "idx_asset_types_category")
  @@map("asset_types")
}

// One record per Gardu per date (BR-012). performanceStatus: 1=Berhasil, 0=Gagal.
// score range 0-100 (Data Dictionary). Yearly partitioning is a PostgreSQL
// target feature (ERD §7); deferred until the PG migration.
model PerformanceDaily {
  id                String   @id @default(uuid()) @db.VarChar(36)
  locationId        String   @db.VarChar(36)
  performanceDate   DateTime @db.Date
  performanceStatus Int
  score             Int?
  createdAt         DateTime @default(now()) @db.Timestamptz(0)

  location Location @relation(fields: [locationId], references: [id], onUpdate: Restrict, map: "performance_daily_location_fk")

  @@unique([locationId, performanceDate], map: "uq_performance_location_date")
  @@index([locationId], map: "idx_performance_location")
  @@index([performanceDate], map: "idx_performance_date")
  @@map("performance_daily")
}

model Ticket {
  id           String         @id @default(uuid()) @db.VarChar(36)
  locationId   String         @db.VarChar(36)
  ticketNumber String         @unique(map: "uq_ticket_number") @db.VarChar(100)
  category     String?        @db.VarChar(100)
  priority     TicketPriority @default(MEDIUM)
  status       TicketStatus   @default(OPEN)
  assignedTo   String?        @db.VarChar(36)
  notes        String?
  openedAt     DateTime?      @db.Timestamptz(0)
  closedAt     DateTime?      @db.Timestamptz(0)
  createdAt    DateTime       @default(now()) @db.Timestamptz(0)
  updatedAt    DateTime       @default(now()) @updatedAt @db.Timestamptz(0)
  deletedAt    DateTime?      @db.Timestamptz(0)

  location Location @relation(fields: [locationId], references: [id], onUpdate: Restrict, map: "tickets_location_fk")
  assignee User?    @relation("TicketAssignee", fields: [assignedTo], references: [id], onUpdate: Restrict, map: "tickets_assignee_fk")

  @@index([locationId], map: "idx_tickets_location")
  @@index([status], map: "idx_tickets_status")
  @@index([priority], map: "idx_tickets_priority")
  @@index([assignedTo], map: "idx_tickets_assignee")
  // Perf audit: ticket list defaults to ORDER BY createdAt DESC — previously
  // an unindexed filesort once the (indexed) status/priority filters narrowed.
  @@index([createdAt], map: "idx_tickets_created")
  @@map("tickets")
}

// Canonical audit trail (ERD §11). Immutable by policy (BR-018). Retention >= 5y.
// Distinct from the legacy `activity_logs` table, which is retained for V1.
model AuditLog {
  id          String      @id @default(uuid()) @db.VarChar(36)
  entityType  String      @db.VarChar(100)
  entityId    String      @db.VarChar(36)
  action      AuditAction
  oldValue    String?
  newValue    String?
  performedBy String?     @db.VarChar(36)
  performedAt DateTime    @default(now()) @db.Timestamptz(0)

  performer User? @relation(fields: [performedBy], references: [id], onUpdate: Restrict, map: "audit_logs_performer_fk")

  @@index([entityType], map: "idx_audit_logs_entity_type")
  @@index([entityId], map: "idx_audit_logs_entity_id")
  @@index([performedBy], map: "idx_audit_logs_performer")
  @@index([performedAt], map: "idx_audit_logs_performed_at")
  @@map("audit_logs")
}

// Reserved — GIS integration (ERD §13). geometry stored as GeoJSON/WKT text.
model SiteGeometry {
  id         String   @id @default(uuid()) @db.VarChar(36)
  locationId String   @db.VarChar(36)
  geometry   String?
  createdAt  DateTime @default(now()) @db.Timestamptz(0)

  location Location @relation(fields: [locationId], references: [id], onUpdate: Restrict, map: "site_geometries_location_fk")

  @@index([locationId], map: "idx_site_geometries_location")
  @@map("site_geometries")
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TicketStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  STATUS_CHANGE
}

// ============================================================
// Enterprise Approval Workflow (ADDITIVE — backward compatible)
//
// A generic, entity-agnostic approval state machine. It does NOT replace the
// legacy `ReportStatus` columns on laporan_awal / laporan_akhir — those keep
// working untouched. Instead a workflow is *attached* to any entity by
// (entityType, entityId); the canonical current state lives in
// `workflow_instances` and every state change is recorded immutably in
// `workflow_transitions` (actor, role, from/to, comment, reason, timestamp).
//
// Lifecycle: DRAFT → SUBMITTED → REVIEWED → APPROVED → CLOSED
//            with REVISION_REQUIRED and REJECTED branches.
// Spec: docs/APPROVAL_WORKFLOW.md
// ============================================================

enum WorkflowState {
  DRAFT
  SUBMITTED
  REVIEWED
  REVISION_REQUIRED
  APPROVED
  REJECTED
  CLOSED
}

model WorkflowInstance {
  id           String        @id @default(uuid()) @db.VarChar(36)
  entityType   String        @db.VarChar(100)
  entityId     String        @db.VarChar(36)
  currentState WorkflowState @default(DRAFT)
  createdBy    String?       @db.VarChar(36)
  createdAt    DateTime      @default(now()) @db.Timestamptz(0)
  updatedAt    DateTime      @default(now()) @updatedAt @db.Timestamptz(0)

  transitions WorkflowTransition[]

  @@unique([entityType, entityId], map: "uq_workflow_entity")
  @@index([entityType], map: "idx_workflow_entity_type")
  @@index([currentState], map: "idx_workflow_state")
  @@map("workflow_instances")
}

// Immutable append-only transition log (one row per state change). Records the
// acting user, their role at action time, the action name, from/to states, an
// optional approval comment and an optional rejection/revision reason.
model WorkflowTransition {
  id              String         @id @default(uuid()) @db.VarChar(36)
  instanceId      String         @db.VarChar(36)
  entityType      String         @db.VarChar(100)
  entityId        String         @db.VarChar(36)
  action          String         @db.VarChar(50)
  fromState       WorkflowState?
  toState         WorkflowState
  performedBy     String?        @db.VarChar(36)
  performedByRole String?        @db.VarChar(50)
  comment         String?
  reason          String?
  performedAt     DateTime       @default(now()) @db.Timestamptz(0)

  instance  WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "workflow_transitions_instance_fk")
  performer User?            @relation("WorkflowTransitionPerformer", fields: [performedBy], references: [id], onUpdate: Restrict, map: "workflow_transitions_performer_fk")

  @@index([instanceId], map: "idx_workflow_tx_instance")
  @@index([entityType, entityId], map: "idx_workflow_tx_entity")
  @@index([performedBy], map: "idx_workflow_tx_performer")
  @@index([performedAt], map: "idx_workflow_tx_performed_at")
  @@map("workflow_transitions")
}

// ── Real-Time Notification System (ADDITIVE) ────────────────────────────────
// Two tables decouple the *what* (a per-user notification = the in-app inbox +
// read state + history) from the *how* (per-channel delivery attempts = the
// queue + retry log). The `notifications` row is created synchronously inside
// the triggering request (best-effort); `notification_deliveries` rows are
// drained asynchronously by the in-process queue worker (notification.queue.ts).
// Spec: docs/NOTIFICATION_SYSTEM.md

// The seven canonical trigger events (TASK §"Trigger Events").
enum NotificationType {
  TASK_ASSIGNED
  REPORT_SUBMITTED
  REPORT_APPROVED
  REPORT_REJECTED
  REVISION_REQUESTED
  TICKET_CREATED
  TICKET_CLOSED
}

enum NotificationDeliveryStatus {
  PENDING // queued, awaiting the worker
  PROCESSING // claimed by the worker for this tick
  SENT // delivered to FCM (best-effort)
  FAILED // attempt failed, will retry until maxAttempts
  DEAD // retries exhausted — no further attempts
}

model Notification {
  id         String           @id @default(uuid()) @db.VarChar(36)
  userId     String           @db.VarChar(36) // recipient
  type       NotificationType
  title      String           @db.VarChar(255)
  body       String
  // Source entity for deep-linking (e.g. "LaporanAwal" / "Ticket").
  entityType String?          @db.VarChar(100)
  entityId   String?          @db.VarChar(36)
  // JSON blob mirrored into the FCM `data` payload (deep-link routing).
  data       String?
  // Idempotency key — unique per recipient. The same (event, entity, actor)
  // produces the same key, so a retried/duplicated trigger is a no-op insert.
  dedupeKey  String           @db.VarChar(255)
  readAt     DateTime?        @db.Timestamptz(0)
  createdAt  DateTime         @default(now()) @db.Timestamptz(0)

  user       User                   @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "notifications_user_fk")
  deliveries NotificationDelivery[]

  @@unique([userId, dedupeKey], map: "uq_notification_dedupe")
  @@index([userId], map: "idx_notification_user")
  @@index([userId, readAt], map: "idx_notification_user_read")
  @@index([createdAt], map: "idx_notification_created")
  // Perf audit: the inbox list filters by userId then ORDER BY createdAt DESC.
  // The userId-only index left MySQL doing a filesort per page — this composite
  // serves both the predicate and the ordering.
  @@index([userId, createdAt], map: "idx_notification_user_created")
  @@map("notifications")
}

// One row per (notification, channel) delivery attempt-set. The queue worker
// claims PENDING rows whose nextAttemptAt is due, calls the channel sender, and
// either marks SENT or schedules the next retry with exponential backoff until
// maxAttempts is reached (then DEAD).
model NotificationDelivery {
  id             String                     @id @default(uuid()) @db.VarChar(36)
  notificationId String                     @db.VarChar(36)
  channel        String                     @default("PUSH") @db.VarChar(20)
  status         NotificationDeliveryStatus @default(PENDING)
  attempts       Int                        @default(0)
  maxAttempts    Int                        @default(5)
  lastError      String?
  nextAttemptAt  DateTime                   @default(now()) @db.Timestamptz(0)
  sentAt         DateTime?                  @db.Timestamptz(0)
  createdAt      DateTime                   @default(now()) @db.Timestamptz(0)
  updatedAt      DateTime                   @default(now()) @updatedAt @db.Timestamptz(0)

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "notification_deliveries_notification_fk")

  @@index([status, nextAttemptAt], map: "idx_notification_delivery_due")
  @@index([notificationId], map: "idx_notification_delivery_notification")
  @@map("notification_deliveries")
}

// ── Offline sync idempotency (ADDITIVE) ──────────────────────────────────────
// Backs the `X-Idempotency-Key` header replayed by the offline sync engine
// (FE/src/lib/offline). Each queued report carries a stable clientId; the
// idempotency middleware reserves the key before the create handler runs and
// stores the success response against it. A retried submit after an *ambiguous*
// failure (server committed the record but the response was lost in transit)
// therefore replays the stored response instead of creating a duplicate.
// Spec: docs/OFFLINE_SYNC_REPORT.md
model IdempotencyKey {
  // The client-generated key (queue item clientId). Primary key = atomic reserve.
  key          String   @id @db.VarChar(255)
  // Owner of the request, for scoping/audit (nullable — header may precede auth).
  userId       String?  @db.VarChar(36)
  // "METHOD /base/path" the key was first used on, so a stray key reused on a
  // different endpoint is visible in audits.
  scope        String   @db.VarChar(255)
  // IN_PROGRESS while the handler runs; COMPLETED once a 2xx response is stored.
  status       String   @default("IN_PROGRESS") @db.VarChar(20)
  statusCode   Int?
  // Serialized success response, replayed verbatim on a duplicate submit.
  responseBody String?
  createdAt    DateTime @default(now()) @db.Timestamptz(0)

  @@index([createdAt], map: "idx_idempotency_created")
  @@map("idempotency_keys")
}

// ── SCADA daily-availability registry (Laporan Gardu RC / GH / GI) ───────────────
// Source of truth for the real-time INS/OOP dashboard. Each row is one gardu of a
// given type, carrying its YTD availability, its current (latest-dated) status and
// the full per-day availability series (JSON) for trend charts. Fed by the Excel
// importer `prisma/seed-scada-laporan.ts`. Additive — touches nothing in V1/V2.
enum ScadaGarduType {
  RC // Gardu RC (remote-control distribusi) — drives the realtime dashboard
  GH // Gardu Hubung
  GI // Gardu Induk
  GFD // Gardu Fault Detector — reserved (file menyusul)
}

// Current SCADA telemetry state for a gardu, derived from its latest-dated
// availability value: 1/partial → IN_SCAN (terpantau), 0 → OOP (out of poll).
enum ScadaStatus {
  IN_SCAN
  OOP
}

model ScadaGardu {
  id            String         @id @default(uuid()) @db.VarChar(36)
  garduType     ScadaGarduType
  code          String         @db.VarChar(150) // Gardu code/name from the report
  up3           String?        @db.VarChar(150)
  rtupp         String?        @db.VarChar(100)
  wilayah       String?        @db.VarChar(100) // GI only (WILAYAH column)
  avaYtd        Float? // %AVA YTD as a 0..1 fraction
  currentValue  Float? // latest-dated daily availability value (0..1)
  currentStatus ScadaStatus? // derived from currentValue
  asOfDate      DateTime?      @db.Date // date of the currentValue column
  daily         Json? // { "2026-01-01": 1, "2026-01-02": 0, ... } non-null days
  sourceFile    String?        @db.VarChar(255)
  importedAt    DateTime       @default(now()) @db.Timestamptz(0)
  createdAt     DateTime       @default(now()) @db.Timestamptz(0)
  updatedAt     DateTime       @default(now()) @updatedAt @db.Timestamptz(0)

  workOrders WorkOrder[]

  @@unique([garduType, code], map: "uq_scada_gardu_type_code")
  @@index([garduType], map: "idx_scada_gardu_type")
  @@index([currentStatus], map: "idx_scada_gardu_status")
  @@index([garduType, currentStatus], map: "idx_scada_gardu_type_status")
  @@map("scada_gardu")
}

// ─────────────────────────────────────────────────────────────────────────────
// Bulk historical inspection import (ADDITIVE, read-only analytics dataset).
//
// One row per equipment-condition inspection visit, bulk-imported from the
// field team's external Google-Sheets-based inspection logs (Laporan Inspeksi
// Gardu Distribusi/MP + Gardu Hubung/GH). This is DISTINCT from
// LaporanInspeksiMp/LaporanInspeksiGh (the app's own WO-gated submission
// workflow): those are live, single-section-JSON, status-gated reports authored
// through the app; this table is a flat historical corpus fed only by
// scripts/import-inspeksi-gardu.ts, feeding the AI Brain's equipment-condition
// queries. A gardu can have many rows over time (one per inspection visit) —
// duplicates across visits are expected, not a bug.
// ─────────────────────────────────────────────────────────────────────────────
model InspeksiGarduRecord {
  id        String   @id @default(uuid()) @db.VarChar(36)
  createdAt DateTime @default(now()) @db.Timestamptz(0)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(0)

  /// "GARDU_MP" | "GARDU_HUBUNG" — which source file this row came from.
  sumberFile String @db.VarChar(20)

  // Identitas
  tanggalPekerjaan DateTime? @db.Date
  userEmail        String?   @db.VarChar(255)
  jenisPekerjaan   String?   @db.VarChar(150)
  up3              String?   @db.VarChar(150)
  kodeGardu        String?   @db.VarChar(100)
  penyulang        String?   @db.VarChar(150)
  sumberListrik220 String?   @db.VarChar(100)
  supplyTr         String?   @db.VarChar(100)

  // Rectifier
  mcbSumberRectifier  String? @db.VarChar(100)
  merkRectifier       String? @db.VarChar(150)
  typeRectifier       String? @db.VarChar(150)
  serialRectifier     String? @db.VarChar(150)
  kondisiRectifier    String? @db.VarChar(100)
  hasilUkurMcb220     Float?
  hasilUkurMcbBat48   Float?
  hasilUkurMcbLoad48  Float?
  keteranganRectifier String?
  kesimpulanRectifier String? @db.VarChar(50) // BAIK | RUSAK | PERLU PENGECEKAN LANJUT
  kategoriRectifier   String? @db.VarChar(100) // detailed non-normal classification (e.g. "SUMBER TEGANGAN TIDAK ADA")

  // Baterai
  jenisBaterai      String? @db.VarChar(100)
  merkBaterai       String? @db.VarChar(150)
  typeBaterai       String? @db.VarChar(150)
  jumlahCell        Int?
  levelAirBaterai   String? @db.VarChar(100)
  backupBaterai     String? @db.VarChar(100)
  keteranganBaterai String?
  kesimpulanBaterai String? @db.VarChar(50)
  kategoriBaterai   String? @db.VarChar(100)

  // RTU
  merkRtu           String? @db.VarChar(150)
  typeRtu           String? @db.VarChar(150)
  serialRtu         String? @db.VarChar(150)
  kondisiRtu        String? @db.VarChar(100)
  kondisiDisplayRtu String? @db.VarChar(100)
  keteranganRtu     String?
  kesimpulanRtu     String? @db.VarChar(50)
  kategoriRtu       String? @db.VarChar(100)

  // Media (modem/router)
  merkMedia       String? @db.VarChar(150)
  typeMedia       String? @db.VarChar(150)
  serialMedia     String? @db.VarChar(150)
  kondisiMedia    String? @db.VarChar(100)
  kondisiAntena   String? @db.VarChar(100)
  keteranganMedia String?
  kesimpulanMedia String? @db.VarChar(50)
  kategoriMedia   String? @db.VarChar(100)

  // Status SCADA & kubikel (GH: first cubicle/feeder-direction block only —
  // GH rows may have a second penyulang/cubicle block in the source that is
  // not captured here)
  statusScada       String? @db.VarChar(50) // INSCAN | OOP style values
  statusRc          String? @db.VarChar(50) // SIAP RC | TIDAK SIAP RC
  keteranganKubikel String?

  // Catatan umum & pelaksana
  catatan       String?
  pelaksana     String?   @db.VarChar(255)
  tanggalUpdate DateTime? @db.Timestamptz(0)

  // Relasi ke Location jika kode gardu ditemukan (nullable — banyak kode di
  // Excel tidak match langsung ke tabel locations)
  locationId String?   @db.VarChar(36)
  location   Location? @relation(fields: [locationId], references: [id], onUpdate: Restrict, map: "inspeksi_gardu_records_location_fk")

  @@index([kodeGardu], map: "idx_inspeksi_gardu_records_kode_gardu")
  @@index([up3], map: "idx_inspeksi_gardu_records_up3")
  @@index([statusScada], map: "idx_inspeksi_gardu_records_status_scada")
  @@index([tanggalPekerjaan], map: "idx_inspeksi_gardu_records_tanggal")
  @@index([kesimpulanRectifier], map: "idx_inspeksi_gardu_records_kesimpulan_rectifier")
  @@index([kesimpulanBaterai], map: "idx_inspeksi_gardu_records_kesimpulan_baterai")
  @@index([kesimpulanRtu], map: "idx_inspeksi_gardu_records_kesimpulan_rtu")
  @@index([kesimpulanMedia], map: "idx_inspeksi_gardu_records_kesimpulan_media")
  @@index([locationId], map: "idx_inspeksi_gardu_records_location")
  @@map("inspeksi_gardu_records")
}

/// Historical HAR (Pemeliharaan) field records imported from the field team's
/// external Google-Sheets logs. Additive analytics table — append-only,
/// never updated, never soft-deleted. Mirror of InspeksiGarduRecord structure
/// with HAR-specific additions (jenisPekerjaan, analisa gangguan, status
/// pekerjaan, ACO detail, dll). Fed only by prisma/import-har-gardu.ts.
/// Catatan sumber (diverifikasi empiris dari file Excel — beda dari inspeksi):
/// di file HAR kolom "KONDISI <X>" berisi verdict bersih (BAIK/RUSAK/PERLU CEK
/// LEBIH LANJUT) sedangkan "KESIMPULAN KODISI <X>" berisi catatan teks bebas —
/// maka kesimpulan* di sini diisi dari KONDISI dan catatan bebasnya masuk
/// keterangan* (Text).
model HarGarduRecord {
  id        String   @id @default(uuid()) @db.VarChar(36)
  createdAt DateTime @default(now()) @db.Timestamptz(0)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(0)

  /// "GARDU_MP" | "GARDU_HUBUNG"
  sumberFile String @db.VarChar(20)

  // Identitas
  tanggalPekerjaan DateTime? @db.Date
  userEmail        String?   @db.VarChar(255)
  jenisPekerjaan   String?   @db.VarChar(150)
  up3              String?   @db.VarChar(150)
  kodeGardu        String?   @db.VarChar(100)
  penyulang        String?   @db.VarChar(150)
  sumberListrik220 String?   @db.VarChar(100)
  supplyTr         String?   @db.VarChar(100)

  // Rectifier
  mcbSumberRectifier  String? @db.VarChar(100)
  merkRectifier       String? @db.VarChar(150)
  typeRectifier       String? @db.VarChar(150)
  serialRectifier     String? @db.VarChar(150)
  kondisiRectifier    String? @db.VarChar(100)
  hasilUkurMcb220     Float?
  hasilUkurMcbBat48   Float?
  hasilUkurMcbLoad48  Float?
  keteranganRectifier String?
  kesimpulanRectifier String? @db.VarChar(50) // BAIK | RUSAK | PERLU CEK LEBIH LANJUT
  kategoriRectifier   String? @db.VarChar(100)

  // Baterai
  jenisBaterai      String? @db.VarChar(100)
  merkBaterai       String? @db.VarChar(150)
  typeBaterai       String? @db.VarChar(150)
  jumlahCell        Int?
  levelAirBaterai   String? @db.VarChar(100)
  backupBaterai     String? @db.VarChar(100)
  keteranganBaterai String?
  kesimpulanBaterai String? @db.VarChar(50)
  kategoriBaterai   String? @db.VarChar(100)

  // RTU
  merkRtu           String? @db.VarChar(150)
  typeRtu           String? @db.VarChar(150)
  serialRtu         String? @db.VarChar(150)
  kondisiRtu        String? @db.VarChar(100)
  kondisiDisplayRtu String? @db.VarChar(100)
  keteranganRtu     String?
  kesimpulanRtu     String? @db.VarChar(50)
  kategoriRtu       String? @db.VarChar(100)

  // Media
  merkMedia       String? @db.VarChar(150)
  typeMedia       String? @db.VarChar(150)
  serialMedia     String? @db.VarChar(150)
  kondisiMedia    String? @db.VarChar(100)
  kondisiAntena   String? @db.VarChar(100)
  keteranganMedia String?
  kesimpulanMedia String? @db.VarChar(50)
  kategoriMedia   String? @db.VarChar(100)

  // HAR-specific: analisa & status pekerjaan
  penyebabGangguan   String?
  analisaGangguan    String?
  langkahPekerjaan   String?
  statusGarduSebelum String? @db.VarChar(100)
  statusGarduSesudah String? @db.VarChar(100)
  statusPekerjaan    String? @db.VarChar(100)

  // Kubikel (first block only — same pattern as InspeksiGarduRecord)
  statusScada       String? @db.VarChar(50) // INSCAN | OOP — proxy dari STATUS GARDU SESUDAH (null jika bukan)
  statusRc          String? @db.VarChar(100) // teks bebas di sumber (maxLen 62 empiris) — sengaja > VarChar(50) inspeksi
  keteranganKubikel String?

  // ACO (header ada di kedua file, tapi 100% kosong pada data 2026-07 — tetap dipetakan)
  adaAco             String? @db.VarChar(20)
  jumlahAco          Int?
  jumlahAcoIntegrasi Int?
  jumlahAcoTidak     Int?
  catatanAcoTidak    String?

  // Catatan umum & pelaksana
  catatan       String?
  pelaksana     String?   @db.VarChar(255)
  tanggalUpdate DateTime? @db.Timestamptz(0)

  // Relasi ke Location (nullable — sama dengan InspeksiGarduRecord)
  locationId String?   @db.VarChar(36)
  location   Location? @relation(fields: [locationId], references: [id], onUpdate: Restrict, map: "har_gardu_records_location_fk")

  @@index([kodeGardu], map: "idx_har_gardu_records_kode_gardu")
  @@index([up3], map: "idx_har_gardu_records_up3")
  @@index([sumberFile], map: "idx_har_gardu_records_sumber_file")
  @@index([tanggalPekerjaan], map: "idx_har_gardu_records_tanggal")
  @@index([kesimpulanRectifier], map: "idx_har_gardu_records_kesimpulan_rectifier")
  @@index([kesimpulanBaterai], map: "idx_har_gardu_records_kesimpulan_baterai")
  @@index([kesimpulanRtu], map: "idx_har_gardu_records_kesimpulan_rtu")
  @@index([kesimpulanMedia], map: "idx_har_gardu_records_kesimpulan_media")
  @@index([locationId], map: "idx_har_gardu_records_location")
  @@map("har_gardu_records")
}

// ─────────────────────────────────────────────────────────────────────────────
// VoltHub AI Brain — Learning Foundation (PHASE 7). ADDITIVE / append-only.
//
// These tables only COLLECT learning data — the Brain does NOT auto-train on
// them. They give us the corpus to (later) tune the dictionary, intent catalog
// and per-user aliases offline, with a human in the loop.
//
// PRIVACY/RBAC: every row is stamped with the asking user + their role + tenant
// (rtuppId) at ask time, so analytics inherit the same isolation as live data.
// No raw query results are stored — only the question, the interpreted intent,
// confidence, and the resolved action.
// ─────────────────────────────────────────────────────────────────────────────

/// One row per assistant turn. The backbone of the learning corpus.
model AiConversation {
  id        String  @id @default(uuid()) @db.VarChar(36)
  sessionId String  @db.VarChar(64)
  userId    String? @db.VarChar(36)
  role      String? @db.VarChar(30) // canonical role at ask time
  rtuppId   String? @db.VarChar(36) // tenant at ask time (null = global)
  channel   String  @default("in_app") @db.VarChar(20) // in_app | whatsapp | voice

  question      String
  intent        String? @db.VarChar(50) // detected IntentId
  confidence    Float? // 0..1
  mode          String? @db.VarChar(20) // EXECUTE | CLARIFY | SUGGEST
  /// Resolved action actually taken, e.g. the queryId or "clarify"/"suggest".
  finalAction   String? @db.VarChar(100)
  /// Clarification option the user picked (Phase 4), if any.
  clarification String? @db.VarChar(120)
  provider      String? @db.VarChar(30) // local | claude | openai | gemini
  replyKind     String? @db.VarChar(20) // answer | clarify | suggest | denied
  /// True when the security layer blocked the turn (prompt injection / RBAC).
  blocked       Boolean @default(false)
  latencyMs     Int?

  createdAt DateTime @default(now()) @db.Timestamptz(0)

  feedback AiFeedback[]

  @@index([userId], map: "idx_ai_conv_user")
  @@index([sessionId], map: "idx_ai_conv_session")
  @@index([intent], map: "idx_ai_conv_intent")
  @@index([createdAt], map: "idx_ai_conv_created")
  @@map("ai_conversations")
}

/// Thumbs up/down (and optional note) on a specific answer.
model AiFeedback {
  id             String   @id @default(uuid()) @db.VarChar(36)
  conversationId String   @db.VarChar(36)
  userId         String?  @db.VarChar(36)
  rating         Int // +1 helpful, -1 not helpful
  note           String?
  createdAt      DateTime @default(now()) @db.Timestamptz(0)

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "ai_feedback_conv_fk")

  @@index([conversationId], map: "idx_ai_feedback_conv")
  @@map("ai_feedback")
}

/// Per-user preferences (favourite questions, default scope, language…).
model AiUserPreference {
  id              String   @id @default(uuid()) @db.VarChar(36)
  userId          String   @unique(map: "uq_ai_pref_user") @db.VarChar(36)
  /// Free-form JSON bag — kept loose so new prefs need no migration.
  prefs           Json?
  /// Snapshot konteks terakhir — disimpan saat session berakhir (warm context
  /// lintas sesi). JSON: { lastIntent, lastGardu, lastUp3, lastTopics: string[],
  /// topIntents: {id,count}[], lastActiveAt: string }
  contextSnapshot Json?
  /// Preferensi output yang dipelajari dari feedback/pemakaian.
  /// JSON: { preferDetail: bool, preferBahasa: 'id'|'formal'|'singkat',
  /// avoidIntents: string[], topGardu: string[], topPenyulang: string[] }
  learnedPrefs    Json?
  updatedAt       DateTime @default(now()) @updatedAt @db.Timestamptz(0)

  @@map("ai_user_preferences")
}

/// Learned vocabulary: a user (or admin) maps a phrase onto a Brain concept.
/// Merged into the dictionary at runtime (resolveConcepts extraEntries).
model AiAlias {
  id        String   @id @default(uuid()) @db.VarChar(36)
  /// Owner scope: null = global alias (MASTER-curated); else a specific user.
  userId    String?  @db.VarChar(36)
  phrase    String   @db.VarChar(120)
  /// Target Brain concept id, e.g. "status.offline" or "entity.gardu".
  concept   String   @db.VarChar(60)
  /// How the alias was created: manual | learned | curated.
  source    String   @default("manual") @db.VarChar(20)
  approved  Boolean  @default(false) // learned aliases need approval before use
  createdAt DateTime @default(now()) @db.Timestamptz(0)

  @@unique([userId, phrase], map: "uq_ai_alias_user_phrase")
  @@index([concept], map: "idx_ai_alias_concept")
  @@map("ai_aliases")
}

/// Catalog of intents the Brain knows, mirrored to the DB for analytics +
/// future admin tuning. Seeded from INTENT_CATALOG; not the runtime source.
model AiIntent {
  id           String   @id @default(uuid()) @db.VarChar(36)
  intentId     String   @unique(map: "uq_ai_intent_id") @db.VarChar(50)
  label        String   @db.VarChar(120)
  queryId      String?  @db.VarChar(60)
  allowedRoles String   @db.VarChar(120) // CSV of canonical roles
  examples     Json?
  enabled      Boolean  @default(true)
  updatedAt    DateTime @default(now()) @updatedAt @db.Timestamptz(0)

  @@map("ai_intents")
}

// ============================================================
// VoltHub — Operation Management System GI RTUPP1 (Work Order domain)
// Additive on top of the existing schema. The Work Order is the entry point of
// the operational workflow:
//   SCADA Event → ADMIN create WO → assign Tim → PETUGAS Laporan Awal →
//   eksekusi → Laporan Akhir → ADMIN approval → WO CLOSED.
// All nullable/defaulted FKs → backward compatible (no data break).
// Tenant boundary stays at Location.rtuppId (WO roots at a GI location).
// ============================================================

enum WorkOrderType {
  CORRECTIVE
  PREVENTIVE
}

enum WorkOrderStatus {
  DRAFT
  ASSIGNED
  ON_PROGRESS
  WAITING_APPROVAL
  APPROVED
  REJECTED
  CLOSED
}

// Laporan Awal per-perangkat condition checklist (Relay/RC/LR/ES/CB).
enum ChecklistCondition {
  NORMAL
  ABNORMAL
  TIDAK_BEROPERASI
}

// Laporan Akhir remote-control test outcome (RC/LR/ES).
enum WorkResult {
  BERHASIL
  GAGAL
}

// Laporan Akhir CB final state.
enum CbStatus {
  NORMAL
  TIDAK_NORMAL
}

// Bay sits between GI (Location) and Penyulang (Feeder)/Asset:
//   GI (Location) → Bay → Penyulang (Feeder) → Asset
model Bay {
  id           String    @id @default(uuid()) @db.VarChar(36)
  locationId   String    @db.VarChar(36) // owning GI
  code         String    @db.VarChar(50)
  name         String    @db.VarChar(255)
  voltageLevel String?   @db.VarChar(50)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now()) @db.Timestamptz(0)
  updatedAt    DateTime  @default(now()) @updatedAt @db.Timestamptz(0)
  createdBy    String?   @db.VarChar(36)
  updatedBy    String?   @db.VarChar(36)
  deletedAt    DateTime? @db.Timestamptz(0)

  location   Location    @relation(fields: [locationId], references: [id], onUpdate: Restrict, map: "bays_location_fk")
  feeders    Feeder[]
  assets     Asset[]
  workOrders WorkOrder[]

  @@unique([locationId, code], map: "uq_bay_location_code")
  @@index([locationId], map: "idx_bays_location")
  @@map("bays")
}

model WorkOrder {
  id          String          @id @default(uuid()) @db.VarChar(36)
  woNumber    String          @unique(map: "uq_wo_number") @db.VarChar(100)
  type        WorkOrderType
  status      WorkOrderStatus @default(DRAFT)
  priority    TicketPriority  @default(MEDIUM)
  title       String          @db.VarChar(255)
  description String?

  // Location hierarchy (GI is the tenant boundary via location.rtuppId)
  locationId String  @db.VarChar(36)
  bayId      String? @db.VarChar(36)
  feederId   String? @db.VarChar(36)
  assetId    String? @db.VarChar(36)

  // Assignment — team only (no per-individual assignee).
  teamId String? @db.VarChar(36)

  // SCADA event source (optional entry point)
  scadaGarduId  String? @db.VarChar(36)
  scadaEventRef String? @db.VarChar(255)

  dueDate DateTime? @db.Date

  // Lifecycle
  createdById  String?   @db.VarChar(36)
  startedAt    DateTime? @db.Timestamptz(0)
  submittedAt  DateTime? @db.Timestamptz(0)
  approvedAt   DateTime? @db.Timestamptz(0)
  rejectedAt   DateTime? @db.Timestamptz(0)
  closedAt     DateTime? @db.Timestamptz(0)
  approvedById String?   @db.VarChar(36)
  rejectedById String?   @db.VarChar(36)
  revisionNote String?

  // Laporan WO — hasil penyelesaian pekerjaan (menggantikan Laporan Akhir).
  // Diisi PETUGAS saat menyelesaikan WO, lalu diajukan untuk approval.
  hasilRC     WorkResult?
  hasilLR     WorkResult?
  hasilES     WorkResult?
  statusCB    CbStatus?
  penyebab    String?
  tindakan    String?
  rekomendasi String?

  // Laporan wajib yang dicentang admin saat membuat WO (GI/RTUPP1).
  // JSON array of string: ["GI"] | ["HAR"] | ["GI","HAR"]. NULL/[] = legacy (tanpa
  // kewajiban → gate penyelesaian lolos otomatis). ADITIF — tak menyentuh hasilRC/RBAC/isolasi.
  requiredReports Json?

  createdAt DateTime  @default(now()) @db.Timestamptz(0)
  updatedAt DateTime  @default(now()) @updatedAt @db.Timestamptz(0)
  deletedAt DateTime? @db.Timestamptz(0)

  location          Location              @relation(fields: [locationId], references: [id], onUpdate: Restrict, map: "work_orders_location_fk")
  bay               Bay?                  @relation(fields: [bayId], references: [id], onUpdate: Restrict, map: "work_orders_bay_fk")
  feeder            Feeder?               @relation(fields: [feederId], references: [id], onUpdate: Restrict, map: "work_orders_feeder_fk")
  asset             Asset?                @relation(fields: [assetId], references: [id], onUpdate: Restrict, map: "work_orders_asset_fk")
  team              Team?                 @relation(fields: [teamId], references: [id], onUpdate: Restrict, map: "work_orders_team_fk")
  createdBy         User?                 @relation("WorkOrderCreatedBy", fields: [createdById], references: [id], onUpdate: Restrict, map: "work_orders_created_by_fk")
  approvedBy        User?                 @relation("WorkOrderApprovedBy", fields: [approvedById], references: [id], onUpdate: Restrict, map: "work_orders_approved_by_fk")
  rejectedBy        User?                 @relation("WorkOrderRejectedBy", fields: [rejectedById], references: [id], onUpdate: Restrict, map: "work_orders_rejected_by_fk")
  scadaGardu        ScadaGardu?           @relation(fields: [scadaGarduId], references: [id], onUpdate: Restrict, map: "work_orders_scada_fk")
  laporanAwal       LaporanAwal[]
  laporanAkhir      LaporanAkhir[]
  attachments       WorkOrderAttachment[]
  laporanGi         LaporanGi[]
  laporanHarGi      LaporanHarGi[]
  laporanInspeksiGh LaporanInspeksiGh[]
  laporanHarGh      LaporanHarGh[]
  laporanInspeksiMp LaporanInspeksiMp[]
  laporanHarMp      LaporanHarMp[]

  @@index([locationId], map: "idx_wo_location")
  @@index([status], map: "idx_wo_status")
  @@index([type], map: "idx_wo_type")
  @@index([teamId], map: "idx_wo_team")
  @@index([dueDate], map: "idx_wo_due")
  @@index([status, createdAt], map: "idx_wo_status_created")
  @@map("work_orders")
}

// Foto/lampiran Laporan WO (mis. FOTO_SEBELUM / FOTO_HASIL). Tabel terpisah dari
// `attachments` (yang terikat ke laporan_awal/akhir) agar plumbing lama tak tersentuh.
model WorkOrderAttachment {
  id           String   @id @default(uuid()) @db.VarChar(36)
  workOrderId  String   @db.VarChar(36)
  originalName String   @db.VarChar(255)
  fileName     String   @db.VarChar(255)
  mimeType     String   @db.VarChar(100)
  size         Int
  path         String   @db.VarChar(500)
  category     String?  @db.VarChar(50) // FOTO_SEBELUM / FOTO_HASIL / LAMPIRAN
  uploadedById String?  @db.VarChar(36)
  uploadedAt   DateTime @default(now()) @db.Timestamptz(0)

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "wo_attachments_wo_fk")

  @@index([workOrderId], map: "idx_wo_attachment_wo")
  @@map("work_order_attachments")
}

// ── Laporan GI (Inspeksi Teknis Lengkap Gardu Induk) ─────────────────────────
// PETUGAS GI mengisi laporan preventif lengkap per gardu+penyulang (152 kolom dari
// "Laporan GI.xlsx"). ADITIF: tidak menyentuh WorkOrder.hasilRC / RBAC / isolasi
// RTUPP (boundary = location.rtuppId, sama seperti modul operasional lain).

// Status workflow Laporan GI (approval admin, semantik mengikuti modul GI yang ada).
enum GiReportStatus {
  DRAFT
  SUBMITTED
  VALIDATED
  REJECTED
}

// Hasil pembanding lapangan vs master SCADA (diisi kelak; TIDAK menyentuh hasilRC).
enum GiComparison {
  BELUM_DIBANDING
  SESUAI
  TIDAK_SESUAI
}

model LaporanGi {
  id String @id @default(uuid()) @db.VarChar(36)

  // ── IDENTITAS (auto-fill dari WO + login; read-only di FE) ──
  locationId  String   @db.VarChar(36) // GARDU — tenant boundary via location.rtuppId
  feederId    String?  @db.VarChar(36) // PENYULANG (opsional; laporan level-RTU bisa null)
  workOrderId String?  @db.VarChar(36) // FK opsional → WorkOrder (auto-fill identitas)
  up3         String?  @db.VarChar(150) // snapshot UP3 (dari location/WO)
  reportDate  DateTime @db.Date // TANGGAL PEKERJAAN
  pelaksana   String?  @db.VarChar(255) // vendor/tim (PT ...)
  inspectorId String?  @db.VarChar(36) // USER pelapor (akun login)

  status           GiReportStatus @default(DRAFT)
  comparisonResult GiComparison   @default(BELUM_DIBANDING)

  // ── Pembanding SCADA (opsional; TIDAK mengubah hasilRC) ──
  scadaRtuName    String? @db.VarChar(255)
  scadaSnapshotId String? @db.VarChar(36)

  // ── Status inti Kubikel + "DI MASTER" (PROMOTED ke kolom scalar agar mudah
  // dibandingkan untuk comparisonResult & kelak derivasi hasilRC). String bebas
  // (CLOSE/OPEN, LOCAL/REMOTE, SESUAI/TIDAK SESUAI, TIMBUL/TIDAK TIMBUL, dst).
  statusPmt         String? @db.VarChar(50)
  statusPmtDiMaster String? @db.VarChar(50)
  statusLr          String? @db.VarChar(50)
  statusLrDiMaster  String? @db.VarChar(50)
  esDiMaster        String? @db.VarChar(50)
  mpufDiMaster      String? @db.VarChar(50)

  // ── PAYLOAD PER-SECTION (Opsi B: JSON per-section) ──
  // Section yang bisa absen menyimpan flag { tidakAda: true } → field-nya di-skip
  // dari validasi wajib.
  rectifier       Json? // Rectifier (selalu ada)
  rectifierBackup Json? // bisa absen → { tidakAda }
  baterai         Json? // { jenis (teks bebas), ... }
  serialDevice    Json? // { utama, device2, jumlah, device2TidakAda }
  rtuIo           Json? // RTU I/O (selalu ada)
  kubikel         Json? // { merekCubicle, elements: { PMT, LR, ... }, keterangan, kesimpulan }
  relayProteksi   Json? // bisa absen → { tidakAda }

  notes   String? // LAIN2
  catatan String? // CATATAN

  // ── Approval admin (DRAFT→SUBMITTED→VALIDATED/REJECTED) ──
  submittedAt    DateTime? @db.Timestamptz(0)
  validatedAt    DateTime? @db.Timestamptz(0)
  validatedBy    String?   @db.VarChar(36)
  validationNote String?

  createdAt DateTime  @default(now()) @db.Timestamptz(0)
  updatedAt DateTime  @default(now()) @updatedAt @db.Timestamptz(0)
  createdBy String?   @db.VarChar(36)
  updatedBy String?   @db.VarChar(36)
  deletedAt DateTime? @db.Timestamptz(0)

  location    Location              @relation(fields: [locationId], references: [id], onUpdate: Restrict, map: "laporan_gi_location_fk")
  feeder      Feeder?               @relation(fields: [feederId], references: [id], onUpdate: Restrict, map: "laporan_gi_feeder_fk")
  workOrder   WorkOrder?            @relation(fields: [workOrderId], references: [id], onUpdate: Restrict, map: "laporan_gi_wo_fk")
  inspector   User?                 @relation("LaporanGiInspector", fields: [inspectorId], references: [id], onUpdate: Restrict, map: "laporan_gi_inspector_fk")
  attachments LaporanGiAttachment[]

  @@index([locationId], map: "idx_laporan_gi_location")
  @@index([feederId], map: "idx_laporan_gi_feeder")
  @@index([workOrderId], map: "idx_laporan_gi_wo")
  @@index([status], map: "idx_laporan_gi_status")
  @@index([status, createdAt], map: "idx_laporan_gi_status_created")
  @@index([reportDate], map: "idx_laporan_gi_date")
  @@map("laporan_gi")
}

// ── Laporan HAR GI (Korektif/Pemeliharaan Gardu Induk — 81 kolom xlsx) ────────
// FASE B. PETUGAS GI mengisi laporan HAR per gardu (RTUPP1). WAJIB ber-WO (beda
// dari LaporanGi yang workOrderId-nya nullable). Opsi B: induk + JSON per-section.
// ADITIF: tidak menyentuh hasilRC / RBAC / isolasi RTUPP / modul `har` legacy.
// Status workflow REUSE enum GiReportStatus (DRAFT/SUBMITTED/VALIDATED/REJECTED).
model LaporanHarGi {
  id String @id @default(uuid()) @db.VarChar(36)

  // ── IDENTITAS (auto-fill dari WO + login; read-only di FE) ──
  workOrderId  String   @db.VarChar(36) // WAJIB → satu jalur approval via WO
  locationId   String   @db.VarChar(36) // GARDU — tenant boundary via location.rtuppId
  feederId     String?  @db.VarChar(36) // PENYULANG (opsional)
  assetId      String?  @db.VarChar(36) // ASET (opsional, auto WO)
  up3          String?  @db.VarChar(150) // snapshot UP3 (dari lokasi)
  reportDate   DateTime @db.Date // TGL PEKERJAAN (no-future)
  ketKunjungan String?  @db.VarChar(255) // KET. KUNJUNGAN (input, dropdown defensif)
  pelaksana    String?  @db.VarChar(255) // PELAKSANA (auto WO team)
  pengawas     String?  @db.VarChar(255) // PENGAWAS (input)
  inspectorId  String?  @db.VarChar(36) // USER pelapor (akun login)

  status GiReportStatus @default(DRAFT)

  scadaRtuName String? @db.VarChar(255)

  // ── Status inti PROMOTED ke scalar (string bebas, defensif — sering difilter/
  //    dashboard; "Berhasil RC" diturunkan dari statusGarduSesudah=INSCAN). ──
  statusGarduSebelum String? @db.VarChar(50)
  statusGarduSesudah String? @db.VarChar(50)
  statusPekerjaan    String? @db.VarChar(50)
  penyebabGangguan   Json? // ARRAY string multi (mis. ["BATERAI","RELAY"]) → chips FE

  // ── PAYLOAD PER-SECTION (Opsi B: JSON per-section) ──
  // Section absentable simpan flag { tidakAda: true } → di-skip dari validasi wajib.
  io           Json? // I/O (merk/type/sn/kondisi/catatan)
  relay        Json? // Relay
  rectifier    Json? // Rectifier
  baterai      Json? // Baterai { jenis, merk, type, kondisi, catatan }
  serialDevice Json? // { jumlah, utama{...,kesimpulan}, device2{...}, device2TidakAda }
  cctv         Json? // { bullet{...}, ptz{...}, nvr{...}, switchPoe{...} + *TidakAda }
  penanganan   Json? // { analisa, langkah, hasil, tambahan, catatanLain }

  // ── Approval admin (mirror via Work Order, sama pola LaporanGi) ──
  submittedAt    DateTime? @db.Timestamptz(0)
  validatedAt    DateTime? @db.Timestamptz(0)
  validatedBy    String?   @db.VarChar(36)
  validationNote String?

  createdAt DateTime  @default(now()) @db.Timestamptz(0)
