// ============================================================
// SCADA Snapshot (Siemens Spectrum Power 7 daily export)
// ============================================================
// The NOC team exports two files from SP7 every day:
//   csd_IFS-IFS_RTUs*.xlsx  → per-gardu RTU state  (fileType "RTU")
//   csd_IFS-IFS_Lines*.xlsx → per-channel IFS state (fileType "LINES")
// Oper State UP = Inscan, DOWN = OOP. Each upload REPLACES the previous
// snapshot of the same fileType (delete-then-insert in one transaction), so at
// most one live snapshot exists per type; rows cascade with their snapshot.

model ScadaSnapshot {
  id         String   @id @default(cuid()) @db.VarChar(36)
  uploadedAt DateTime @default(now()) @db.Timestamptz(0)
  uploadedBy String   @db.VarChar(36)
  uploader   User     @relation(fields: [uploadedBy], references: [id], map: "scada_snapshots_uploader_fk")
  fileType   String   @db.VarChar(10) // "RTU" | "LINES"
  totalRows  Int
  totalUp    Int
  totalDown  Int
  notes      String?

  rtuRows  ScadaRtuRow[]
  lineRows ScadaLineRow[]

  // Latest-per-type lookup (every read endpoint starts from it).
  @@index([fileType, uploadedAt], map: "idx_scada_snapshots_type_at")
  @@index([uploadedBy], map: "idx_scada_snapshots_uploader")
  @@map("scada_snapshots")
}

model ScadaRtuRow {
  id         String        @id @default(cuid()) @db.VarChar(36)
  snapshotId String        @db.VarChar(36)
  snapshot   ScadaSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade, map: "scada_rtu_rows_snapshot_fk")

  rtuName        String  @db.VarChar(100) // kolom "RTU Name"
  rtuText        String? @db.VarChar(255) // kolom "RTU Text"
  operState      String  @db.VarChar(10) // "UP" | "DOWN"
  adminState     String? @db.VarChar(10) // "ON" | "OFF"
  protocol       String? @db.VarChar(20) // "IEC104" | "IEC101u"
  pairNr         Int?
  channelPrimary Int?
  server         String? @db.VarChar(50) // "gbr12ifs(12)" dst
  asdu           String? @db.VarChar(50)

  // Link ke Location jika rtuName match Location.code (case-insensitive).
  // Banyak yang tidak match (penamaan Siemens ≠ kode gardu) — null = normal.
  locationId String?   @db.VarChar(36)
  location   Location? @relation(fields: [locationId], references: [id], map: "scada_rtu_rows_location_fk")

  @@index([snapshotId], map: "idx_scada_rtu_rows_snapshot")
  @@index([rtuName], map: "idx_scada_rtu_rows_name")
  @@index([operState], map: "idx_scada_rtu_rows_oper_state")
  @@index([locationId], map: "idx_scada_rtu_rows_location")
  @@map("scada_rtu_rows")
}

model ScadaLineRow {
  id         String        @id @default(cuid()) @db.VarChar(36)
  snapshotId String        @db.VarChar(36)
  snapshot   ScadaSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade, map: "scada_line_rows_snapshot_fk")

  pairId      Int?
  channelId   Int?
  ifsServer   String? @db.VarChar(50) // "gbr11ifs(11)" | "gbr12ifs(12)"
  channelName String? @db.VarChar(100)
  channelText String? @db.VarChar(255)
  adminState  String? @db.VarChar(10)
  // "UP" | "DOWN" — null untuk slot channel UNASG yang tidak membawa Oper
  // State di export SP7 (mayoritas baris; tetap disimpan agar file terbaca utuh).
  operState   String? @db.VarChar(10)
  assigned    String? @db.VarChar(10) // "ASG" | "UNASG"
  dataXfr     String? @db.VarChar(10) // "ON" | "OFF"
  deviceType  String? @db.VarChar(30)
  ipAddr      String? @db.VarChar(100)
  port        String? @db.VarChar(50)

  @@index([snapshotId], map: "idx_scada_line_rows_snapshot")
  @@index([operState], map: "idx_scada_line_rows_oper_state")
  @@index([ifsServer], map: "idx_scada_line_rows_ifs_server")
  @@map("scada_line_rows")
}
