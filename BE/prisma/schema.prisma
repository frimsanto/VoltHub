generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                          String               @id @default(uuid()) @db.VarChar(36)
  email                       String               @unique(map: "email") @db.VarChar(255)
  password                    String               @db.VarChar(255)
  name                        String               @db.VarChar(255)
  role                        UserRole?            @default(PETUGAS)
  phone                       String?              @db.VarChar(50)
  avatar                      String?              @db.VarChar(255)
  isActive                    Boolean?             @default(true)
  mustChangePassword          Boolean?             @default(false)
  rtuppId                     String?              @db.VarChar(36)
  teamId                      String?              @db.VarChar(36)
  roleId                      String?              @db.VarChar(36)
  createdAt                   DateTime?            @default(now()) @db.Timestamptz(0)
  updatedAt                   DateTime?            @default(now()) @updatedAt @db.Timestamptz(0)
  activityLogs                ActivityLog[]
  attachments                 Attachment[]
  laporanAkhirCreated         LaporanAkhir[]       @relation("LaporanAkhirCreatedBy")
  laporanAkhirUpdated         LaporanAkhir[]       @relation("LaporanAkhirUpdatedBy")
  laporanAkhirApproved        LaporanAkhir[]       @relation("LaporanAkhirApprovedBy")
  laporanAkhirRejected        LaporanAkhir[]       @relation("LaporanAkhirRejectedBy")
  laporanAwalCreated          LaporanAwal[]        @relation("LaporanAwalCreatedBy")
  laporanAwalUpdated          LaporanAwal[]        @relation("LaporanAwalUpdatedBy")
  laporanAwalApproved         LaporanAwal[]        @relation("LaporanAwalApprovedBy")
  laporanAwalRejected         LaporanAwal[]        @relation("LaporanAwalRejectedBy")
  validations                 ReportValidation[]
  deviceTokens                DeviceToken[]
  refreshTokens               RefreshToken[]
  inspectionsAsInspector      Inspection[]         @relation("InspectionInspector")
  teams_teams_leaderIdTousers Team[]               @relation("teams_leaderIdTousers")
  rtupp                       RTUPP?               @relation(fields: [rtuppId], references: [id], onUpdate: Restrict, map: "users_ibfk_1")
  team                        Team?                @relation(fields: [teamId], references: [id], onUpdate: Restrict, map: "users_ibfk_2")
  // V2 additive: canonical role table bridge (legacy `role` enum kept until controller migration)
  roleRef                     Role?                @relation(fields: [roleId], references: [id], onUpdate: Restrict, map: "users_role_fk")
  auditLogs2                  AuditLog[]
  assignedTickets             Ticket[]             @relation("TicketAssignee")
  workflowTransitions         WorkflowTransition[] @relation("WorkflowTransitionPerformer")
  notifications               Notification[]       @relation("UserNotifications")
  workOrdersCreated           WorkOrder[]          @relation("WorkOrderCreatedBy")
  workOrdersApproved          WorkOrder[]          @relation("WorkOrderApprovedBy")
  workOrdersRejected          WorkOrder[]          @relation("WorkOrderRejectedBy")
  laporanGiReports            LaporanGi[]          @relation("LaporanGiInspector")
  laporanHarGiReports         LaporanHarGi[]       @relation("LaporanHarGiInspector")
  laporanInspeksiGhReports    LaporanInspeksiGh[]  @relation("LaporanInspeksiGhInspector")
  laporanHarGhReports         LaporanHarGh[]       @relation("LaporanHarGhInspector")
  laporanInspeksiMpReports    LaporanInspeksiMp[]  @relation("LaporanInspeksiMpInspector")
  laporanHarMpReports         LaporanHarMp[]       @relation("LaporanHarMpInspector")
  scadaSnapshots              ScadaSnapshot[]

  @@index([email], map: "idx_user_email")
  @@index([role], map: "idx_user_role")
  @@index([rtuppId], map: "idx_user_rtupp")
  @@index([teamId], map: "idx_user_team")
  @@index([roleId], map: "idx_user_role_id")
  @@map("users")
}

model DeviceToken {
  id        String    @id @default(uuid()) @db.VarChar(36)
  userId    String    @db.VarChar(36)
  token     String    @unique(map: "token") @db.VarChar(512)
  platform  String?   @db.VarChar(20)
  createdAt DateTime? @default(now()) @db.Timestamptz(0)
  updatedAt DateTime? @default(now()) @updatedAt @db.Timestamptz(0)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "device_tokens_ibfk_1")

  @@index([userId], map: "idx_device_token_user")
  @@map("device_tokens")
}

// Server-side refresh-token store enabling revocation + rotation.
// One row per issued refresh token. `tokenHash` is the SHA-256 of the JWT (the
// raw token is never stored). `familyId` groups every token produced by rotation
// from a single login (a "session"); revoking a family logs out that device, and
// presenting an already-rotated (revoked) token triggers family-wide revocation
// as a reuse/compromise defence.
model RefreshToken {
  id           String    @id @default(uuid()) @db.VarChar(36)
  userId       String    @db.VarChar(36)
  tokenHash    String    @unique(map: "token_hash") @db.VarChar(64)
  familyId     String    @db.VarChar(36)
  expiresAt    DateTime  @db.Timestamptz(0)
  revokedAt    DateTime? @db.Timestamptz(0)
  replacedById String?   @db.VarChar(36)
  userAgent    String?
  ipAddress    String?   @db.VarChar(100)
  createdAt    DateTime  @default(now()) @db.Timestamptz(0)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "refresh_tokens_ibfk_1")

  @@index([userId], map: "idx_refresh_token_user")
  @@index([familyId], map: "idx_refresh_token_family")
  @@map("refresh_tokens")
}

model RTUPP {
  id             String        @id @default(uuid()) @db.VarChar(36)
  code           String        @unique(map: "uq_rtupp_code") @db.VarChar(50)
  name           String        @db.VarChar(255)
  region         String?       @db.VarChar(255)
  address        String?
  phone          String?       @db.VarChar(50)
  isActive       Boolean?      @default(true)
  organizationId String?       @db.VarChar(36)
  createdAt      DateTime?     @default(now()) @db.Timestamptz(0)
  updatedAt      DateTime?     @default(now()) @updatedAt @db.Timestamptz(0)
  teams          Team[]
  users          User[]
  personil       Personil[]
  // V2 additive: organization tree wiring
  organization   Organization? @relation(fields: [organizationId], references: [id], onUpdate: Restrict, map: "rtupps_organization_fk")
  up3s           Up3[]
  // Tenant ownership of operational sites (gardu). See Location.rtuppId.
  locations      Location[]

  @@index([code], map: "idx_rtupp_code")
  @@index([organizationId], map: "idx_rtupp_organization")
  @@map("rtupps")
}

model Personil {
  id        String    @id @default(uuid()) @db.VarChar(36)
  nip       String    @unique(map: "nip") @db.VarChar(50)
  nama      String    @db.VarChar(255)
  jabatan   String    @db.VarChar(255)
  rtuppId   String    @db.VarChar(36)
  isActive  Boolean   @default(true)
  createdAt DateTime? @default(now()) @db.Timestamptz(0)
  updatedAt DateTime? @default(now()) @updatedAt @db.Timestamptz(0)
  rtupp     RTUPP     @relation(fields: [rtuppId], references: [id], onUpdate: Restrict, map: "personil_ibfk_1")

  @@index([rtuppId], map: "idx_personil_rtupp")
  @@index([isActive], map: "idx_personil_active")
  @@index([nip], map: "idx_personil_nip")
  @@map("personil")
}

model Team {
  id                          String      @id @default(uuid()) @db.VarChar(36)
  name                        String      @db.VarChar(255)
  code                        String      @unique(map: "uq_team_code") @db.VarChar(50)
  rtuppId                     String      @db.VarChar(36)
  leaderId                    String?     @db.VarChar(36)
  isActive                    Boolean?    @default(true)
  createdAt                   DateTime?   @default(now()) @db.Timestamptz(0)
  updatedAt                   DateTime?   @default(now()) @updatedAt @db.Timestamptz(0)
  rtupp                       RTUPP       @relation(fields: [rtuppId], references: [id], onUpdate: Restrict, map: "teams_ibfk_1")
  users_teams_leaderIdTousers User?       @relation("teams_leaderIdTousers", fields: [leaderId], references: [id], onUpdate: Restrict, map: "teams_ibfk_2")
  members                     User[]
  workOrders                  WorkOrder[]

  @@index([code], map: "idx_team_code")
  @@index([rtuppId], map: "idx_team_rtupp")
  @@index([leaderId], map: "leaderId")
  @@map("teams")
}

model LaporanAwal {
  id                 String   @id @default(uuid()) @db.VarChar(36)
  reportId           String   @unique(map: "uq_laporan_awal_reportId") @db.VarChar(50)
  hari               String   @db.VarChar(50)
  tanggal            DateTime @db.Date
  nomorSPJ           String   @db.VarChar(100)
  up3                String   @db.VarChar(255)
  pekerjaan          String
  lokasiGardu        String   @db.VarChar(255)
  pelaksana          String   @db.VarChar(255)
  penanggungJawab    String   @db.VarChar(255)
  pengawasPekerjaan  String?  @db.VarChar(255)
  pengawasManuver    String?  @db.VarChar(255)
  pengawasK3         String?  @db.VarChar(255)
  nomorWP            String?  @db.VarChar(100)
  potensiBahaya      String
  pengendalianRisiko String
  apd                String?  @db.VarChar(255)
  rambuKerja         String?  @db.VarChar(255)
  asuransiTK         String?  @db.VarChar(255)

  // Safety Checklist (K3) persistence
  wpJsahirarcSop          Boolean? @default(false)
  kondisiPersonil         String?  @default("SEHAT") @db.VarChar(50)
  potensiBahayaDijelaskan Boolean? @default(false)
  apdLengkap              Boolean? @default(false)
  asuransiKetenagakerjaan Boolean? @default(false)
  berdoaSebelumBekerja    Boolean? @default(false)

  // Personil Snapshot (audit trail, immutable copy at submit time)
  jumlahPersonil   Int?  @default(0)
  personilSnapshot Json?

  // ADDITIVE: Work Order link (laporan lahir dari WO). Nullable → legacy reports OK.
  workOrderId String? @db.VarChar(36)

  // ADDITIVE: kondisi perangkat checklist (Laporan Awal)
  cekRelay    ChecklistCondition?
  cekRC       ChecklistCondition?
  cekLR       ChecklistCondition?
  cekES       ChecklistCondition?
  cekStatusCB ChecklistCondition?

  // New status system
  status       ReportStatus @default(DRAFT)
  revisionNote String?
  submittedAt  DateTime?    @db.Timestamptz(0)
  approvedAt   DateTime?    @db.Timestamptz(0)
  rejectedAt   DateTime?    @db.Timestamptz(0)
  approvedById String?      @db.VarChar(36)
  rejectedById String?      @db.VarChar(36)
  updatedById  String?      @db.VarChar(36)

  // Legacy status for backward compatibility
  legacyStatus laporan_awal_status? @default(DRAFT)

  createdById   String             @db.VarChar(36)
  createdAt     DateTime?          @default(now()) @db.Timestamptz(0)
  updatedAt     DateTime?          @default(now()) @updatedAt @db.Timestamptz(0)
  activityLogs  ActivityLog[]
  attachments   Attachment[]
  createdBy     User               @relation("LaporanAwalCreatedBy", fields: [createdById], references: [id], onUpdate: Restrict, map: "laporan_awal_ibfk_1")
  laporan_akhir LaporanAkhir?
  workOrder     WorkOrder?         @relation(fields: [workOrderId], references: [id], onUpdate: Restrict, map: "laporan_awal_wo_fk")
  validations   ReportValidation[]
  updatedBy     User?              @relation("LaporanAwalUpdatedBy", fields: [updatedById], references: [id], onUpdate: Restrict, map: "laporan_awal_ibfk_2")
  approvedBy    User?              @relation("LaporanAwalApprovedBy", fields: [approvedById], references: [id], onUpdate: Restrict, map: "laporan_awal_ibfk_3")
  rejectedBy    User?              @relation("LaporanAwalRejectedBy", fields: [rejectedById], references: [id], onUpdate: Restrict, map: "laporan_awal_ibfk_4")

  @@index([createdById], map: "idx_laporan_awal_createdBy")
  @@index([reportId], map: "idx_laporan_awal_reportId")
  @@index([status], map: "idx_laporan_awal_status")
  @@index([workOrderId], map: "idx_laporan_awal_wo")
  @@index([tanggal], map: "idx_laporan_awal_tanggal")
  // Perf audit: dashboard "today"/14-day trend, KPI monthly trend and history
  // ordering all range/sort on createdAt — previously a full scan.
  @@index([createdAt], map: "idx_laporan_awal_created")
  // Perf audit: history/rekap filter by status THEN order by createdAt — a
  // composite lets MySQL satisfy the predicate and the sort from one index.
  @@index([status, createdAt], map: "idx_laporan_awal_status_created")
  @@map("laporan_awal")
}

model LaporanAkhir {
  id                   String                         @id @default(uuid()) @db.VarChar(36)
  reportId             String                         @unique(map: "uq_laporan_akhir_reportId") @db.VarChar(50)
  laporanAwalId        String?                        @unique(map: "uq_laporan_akhir_laporanAwalId") @db.VarChar(36)
  nomorSPJ             String                         @db.VarChar(100)
  tanggalSelesai       DateTime                       @db.Date
  up3                  String                         @db.VarChar(255)
  pekerjaan            String
  namaAset             String                         @db.VarChar(255)
  tagSCADA             String?                        @db.VarChar(100)
  bayPosisi            String?                        @db.VarChar(100)
  teganganNominal      String?                        @db.VarChar(50)
  detailLangkah        String
  hasilTahananIsolasi  String?                        @db.VarChar(100)
  hasilPengukuranBeban String?                        @db.VarChar(100)
  catatanHasil         String?
  statusPekerjaan      laporan_akhir_statusPekerjaan? @default(SELESAI)
  durasiPekerjaan      String?                        @db.VarChar(100)
  catatanTambahan      String?
  status               ReportStatus?                  @default(DRAFT)

  // ADDITIVE: Work Order link
  workOrderId String? @db.VarChar(36)

  // ADDITIVE: hasil uji remote (Laporan Akhir checklist)
  hasilRC          WorkResult?
  hasilLR          WorkResult?
  hasilES          WorkResult?
  statusCB         CbStatus?
  penyebab         String?
  tindakan         String?
  rekomendasi      String?
  // Operational SCADA fields
  gardu            String?                         @db.VarChar(255)
  jenisPekerjaan   String?                         @db.VarChar(255)
  asdu             String?                         @db.VarChar(20)
  ipModem          String?                         @db.VarChar(50)
  ipRTU            String?                         @db.VarChar(50)
  ipSIM1           String?                         @db.VarChar(50)
  ipSIM2           String?                         @db.VarChar(50)
  ipGTWIconPlus    String?                         @db.VarChar(50)
  ipWAN            String?                         @db.VarChar(50)
  rtuNama          String?                         @db.VarChar(255)
  rtuType          String?                         @db.VarChar(100)
  mediaNama        String?                         @db.VarChar(255)
  mediaType        String?                         @db.VarChar(100)
  rectifierNama    String?                         @db.VarChar(255)
  rectifierType    String?                         @db.VarChar(100)
  bateraiNama      String?                         @db.VarChar(255)
  bateraiType      String?                         @db.VarChar(100)
  catatanRTU       laporan_akhir_catatanPerangkat?
  catatanMedia     laporan_akhir_catatanPerangkat?
  catatanRectifier laporan_akhir_catatanPerangkat?
  catatanBaterai   laporan_akhir_catatanBaterai?
  catatanLain      String?
  statusSebelum    laporan_akhir_statusGardu?
  statusSesudah    laporan_akhir_statusGardu?
  pengawas         String?                         @db.VarChar(255)
  pelaksana        String?                         @db.VarChar(255)
  createdById      String                          @db.VarChar(36)
  createdAt        DateTime?                       @default(now()) @db.Timestamptz(0)
  updatedAt        DateTime?                       @default(now()) @updatedAt @db.Timestamptz(0)
  updatedById      String?                         @db.VarChar(36)
  submittedAt      DateTime?                       @db.Timestamptz(0)
  approvedAt       DateTime?                       @db.Timestamptz(0)
  rejectedAt       DateTime?                       @db.Timestamptz(0)
  approvedById     String?                         @db.VarChar(36)
  rejectedById     String?                         @db.VarChar(36)
  validatedAt      DateTime?                       @db.Timestamptz(0)
  activityLogs     ActivityLog[]
  attachments      Attachment[]
  createdBy        User                            @relation("LaporanAkhirCreatedBy", fields: [createdById], references: [id], onUpdate: Restrict, map: "laporan_akhir_ibfk_1")
  laporan_awal     LaporanAwal?                    @relation(fields: [laporanAwalId], references: [id], onUpdate: Restrict, map: "laporan_akhir_ibfk_2")
  workOrder        WorkOrder?                      @relation(fields: [workOrderId], references: [id], onUpdate: Restrict, map: "laporan_akhir_wo_fk")
  validations      ReportValidation[]
  updatedBy        User?                           @relation("LaporanAkhirUpdatedBy", fields: [updatedById], references: [id], onUpdate: Restrict, map: "laporan_akhir_ibfk_3")
  approvedBy       User?                           @relation("LaporanAkhirApprovedBy", fields: [approvedById], references: [id], onUpdate: Restrict, map: "laporan_akhir_ibfk_4")
  rejectedBy       User?                           @relation("LaporanAkhirRejectedBy", fields: [rejectedById], references: [id], onUpdate: Restrict, map: "laporan_akhir_ibfk_5")

  @@index([createdById], map: "idx_laporan_akhir_createdBy")
  @@index([reportId], map: "idx_laporan_akhir_reportId")
  @@index([status], map: "idx_laporan_akhir_status")
  @@index([workOrderId], map: "idx_laporan_akhir_wo")
  // Perf audit: parity with laporan_awal — createdAt drives dashboard/KPI
  // trends and history sort; (status, createdAt) covers filter-then-sort.
  @@index([createdAt], map: "idx_laporan_akhir_created")
  @@index([status, createdAt], map: "idx_laporan_akhir_status_created")
  // Perf audit: rekap-akhir defaults to ORDER BY tanggalSelesai DESC + range
  // filtering on it; was previously unindexed (full scan + filesort).
  @@index([tanggalSelesai], map: "idx_laporan_akhir_tanggal_selesai")
  @@map("laporan_akhir")
}

model Attachment {
  id             String               @id @default(uuid()) @db.VarChar(36)
  originalName   String               @db.VarChar(255)
  fileName       String               @db.VarChar(255)
  mimeType       String               @db.VarChar(100)
  size           Int
  path           String               @db.VarChar(500)
  laporanAwalId  String?              @db.VarChar(36)
  laporanAkhirId String?              @db.VarChar(36)
  category       attachments_category
  uploadedById   String               @db.VarChar(36)
  uploadedAt     DateTime?            @default(now()) @db.Timestamptz(0)
  laporanAwal    LaporanAwal?         @relation(fields: [laporanAwalId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "attachments_ibfk_1")
  laporanAkhir   LaporanAkhir?        @relation(fields: [laporanAkhirId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "attachments_ibfk_2")
  users          User                 @relation(fields: [uploadedById], references: [id], onUpdate: Restrict, map: "attachments_ibfk_4")

  @@index([category], map: "idx_attachment_category")
  @@index([laporanAkhirId], map: "idx_attachment_laporan_akhir")
  @@index([laporanAwalId], map: "idx_attachment_laporan_awal")
  @@index([uploadedById], map: "uploadedById")
  @@map("attachments")
}

model ReportValidation {
  id             String           @id @default(uuid()) @db.VarChar(36)
  laporanAwalId  String?          @db.VarChar(36)
  laporanAkhirId String?          @db.VarChar(36)
  validatorId    String           @db.VarChar(36)
  status         ValidationAction
  notes          String?
  validatedAt    DateTime?        @default(now()) @db.Timestamptz(0)
  laporanAwal    LaporanAwal?     @relation(fields: [laporanAwalId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "report_validations_ibfk_1")
  laporanAkhir   LaporanAkhir?    @relation(fields: [laporanAkhirId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "report_validations_ibfk_2")
  validator      User             @relation(fields: [validatorId], references: [id], onUpdate: Restrict, map: "report_validations_ibfk_4")

  @@index([validatedAt], map: "idx_validation_date")
  @@index([laporanAkhirId], map: "idx_validation_laporan_akhir")
  @@index([laporanAwalId], map: "idx_validation_laporan_awal")
  @@index([validatorId], map: "idx_validation_validator")
  @@map("report_validations")
}

model ActivityLog {
  id             String                   @id @default(uuid()) @db.VarChar(36)
  userId         String                   @db.VarChar(36)
  action         ActivityAction
  entityType     activity_logs_entityType
  entityId       String?                  @db.VarChar(36)
  laporanAwalId  String?                  @db.VarChar(36)
  laporanAkhirId String?                  @db.VarChar(36)
  details        String?
  ipAddress      String?                  @db.VarChar(100)
  userAgent      String?
  createdAt      DateTime?                @default(now()) @db.Timestamptz(0)
  user           User                     @relation(fields: [userId], references: [id], onUpdate: Restrict, map: "activity_logs_ibfk_1")
  laporanAwal    LaporanAwal?             @relation(fields: [laporanAwalId], references: [id], onUpdate: Restrict, map: "activity_logs_ibfk_2")
  laporanAkhir   LaporanAkhir?            @relation(fields: [laporanAkhirId], references: [id], onUpdate: Restrict, map: "activity_logs_ibfk_3")

  @@index([action], map: "idx_log_action")
  @@index([createdAt], map: "idx_log_created")
  @@index([entityType], map: "idx_log_entity_type")
  @@index([userId], map: "idx_log_user")
  @@index([laporanAkhirId], map: "laporanAkhirId")
  @@index([laporanAwalId], map: "idx_activity_logs_laporanAwalId")
  @@map("activity_logs")
}

enum UserRole {
  // VoltHub canonical 4-role hierarchy. MASTER (system owner) and MANAGER
  // (read-only full access) are additive; the legacy values are retained so
  // existing rows/tokens keep working and are normalized in src/auth/roles.ts:
  //   SUPERADMIN → MASTER, ADMIN_RTUPP → ADMIN.
  MASTER
  MANAGER
  SUPERADMIN
  ADMIN
  ADMIN_RTUPP
  PETUGAS
  // NOC — control-room operator. Not RTUPP-bound (rtuppId null, like MASTER).
  // Uploads the daily Siemens SP7 SCADA exports and reads the SCADA/GIS
  // monitoring surface; no laporan approval, user management, or WO access.
  NOC
}

// ============================================================
// VoltReport V2 — Asset Management Domain (Sprint 1)
// Additive to the existing MySQL schema. Follows V1 conventions:
// VarChar(36) UUID PK, DateTime(0) audit columns, soft delete.
// Spec: TDD_DATABASE_VoltReport_V2.md / PRISMA_SCHEMA_VoltReport_V2.md
// ============================================================

enum LocationType {
  GI
  GH
  GARDU
}

enum AssetType {
  RTU
  FDI
  RECTIFIER
  BATTERY_BANK
  ROUTER
  MODEM
  RADIO
}

enum AssetStatus {
  ACTIVE
  WARNING
  DAMAGED
  RETIRED
}

enum CommunicationMediaType {
  GSM_4G
  GSM_2G
  RADIO_DATA
  FO
  ICON_GSM
  ICON_IPVPN
}

enum InspectionStatus {
  NORMAL
  WARNING
  CRITICAL
}

enum HarStatus {
  NORMAL
  WARNING
  CRITICAL
  OFFLINE
}

enum DocumentType {
  PHOTO
  BERITA_ACARA
  MANUAL_BOOK
  SERTIFIKAT
  INSPECTION_DOC
  OTHER
}

model Location {
  id           String       @id @default(uuid()) @db.VarChar(36)
  code         String       @unique(map: "uq_location_code") @db.VarChar(50)
  name         String       @db.VarChar(255)
  locationType LocationType
  up3          String?      @db.VarChar(150)
  address      String?
  latitude     Float?       @db.DoublePrecision
  longitude    Float?       @db.DoublePrecision
  status       Boolean      @default(true)
  createdAt    DateTime     @default(now()) @db.Timestamptz(0)
  updatedAt    DateTime     @default(now()) @updatedAt @db.Timestamptz(0)
  createdBy    String?      @db.VarChar(36)
  updatedBy    String?      @db.VarChar(36)
  deletedAt    DateTime?    @db.Timestamptz(0)

  // The penyulang (feeder) that SUPPLIES this gardu. Distinct from `feeders`
  // (penyulang REGISTERED at this location, e.g. a GH's outgoing penyulang):
  // a distribution gardu is fed by exactly one upstream penyulang. Source: the
  // "GD" sheet (gardu distribusi → penyulang). ADDITIVE / nullable.
  supplyFeederId String? @db.VarChar(36)

  // Tenant key (ADDITIVE / nullable). The operational domain (assets, inspections,
  // HAR, tickets, documents, performance) roots at Location, so this FK is the
  // single tenant boundary for RTUPP/UP3 data isolation: ADMIN/PETUGAS are scoped
  // to their own RTUPP's locations, MASTER/MANAGER see all. The legacy free-text
  // `up3` column is a ULP sub-area label (one level BELOW RTUPP) and is NOT a
  // tenant key — it is left untouched. Backfilled to the owning RTUPP on migration.
  rtuppId String? @db.VarChar(36)

  feeders              Feeder[]
  assets               Asset[]
  communicationMedia   CommunicationMedia[]
  inspections          Inspection[]
  harReports           HarReport[]
  documents            Document[]
  generatedReports     GeneratedReport[]
  // V2 additive: Gardu-centric operational tables attach to the de-facto Site (locations)
  performanceRecords   PerformanceDaily[]
  tickets              Ticket[]
  siteGeometries       SiteGeometry[]
  bays                 Bay[]
  workOrders           WorkOrder[]
  laporanGi            LaporanGi[]
  laporanHarGi         LaporanHarGi[]
  laporanInspeksiGh    LaporanInspeksiGh[]
  laporanHarGh         LaporanHarGh[]
  laporanInspeksiMp    LaporanInspeksiMp[]
  laporanHarMp         LaporanHarMp[]
  inspeksiGarduRecords InspeksiGarduRecord[]
  harGarduRecords      HarGarduRecord[]
  scadaRtuRows         ScadaRtuRow[]
  supplyFeeder         Feeder?               @relation("GarduSupplyFeeder", fields: [supplyFeederId], references: [id], onUpdate: Restrict, map: "locations_supply_feeder_fk")
  rtupp                RTUPP?                @relation(fields: [rtuppId], references: [id], onUpdate: Restrict, map: "locations_rtupp_fk")

  @@index([code], map: "idx_locations_code")
  @@index([locationType], map: "idx_locations_type")
  @@index([up3], map: "idx_locations_up3")
  @@index([supplyFeederId], map: "idx_locations_supply_feeder")
  // Tenant isolation: scoped reads/writes filter on rtuppId (or location.rtuppId
  // for the operational tables) — index turns the per-request scope predicate
  // into a range scan instead of a full table scan over 14k+ gardu.
  @@index([rtuppId], map: "idx_locations_rtupp")
  // Perf audit: GIS viewport queries push the map bbox to SQL as a
  // (latitude, longitude) range — composite index turns the per-pan full
  // table scan into an index range scan over on-screen sites only.
  @@index([latitude, longitude], map: "idx_locations_geo")
  @@map("locations")
}

model Feeder {
  id         String    @id @default(uuid()) @db.VarChar(36)
  locationId String    @db.VarChar(36)
  bayId      String?   @db.VarChar(36) // ADDITIVE: GI → Bay → Penyulang
  feederCode String    @db.VarChar(50)
  feederName String    @db.VarChar(255)
  createdAt  DateTime  @default(now()) @db.Timestamptz(0)
  updatedAt  DateTime  @default(now()) @updatedAt @db.Timestamptz(0)
  createdBy  String?   @db.VarChar(36)
  updatedBy  String?   @db.VarChar(36)
  deletedAt  DateTime? @db.Timestamptz(0)

  location          Location            @relation(fields: [locationId], references: [id], onUpdate: Restrict, map: "feeders_location_fk")
  bay               Bay?                @relation(fields: [bayId], references: [id], onUpdate: Restrict, map: "feeders_bay_fk")
  assets            Asset[]
  workOrders        WorkOrder[]
  laporanGi         LaporanGi[]
  laporanHarGi      LaporanHarGi[]
  laporanInspeksiGh LaporanInspeksiGh[]
  laporanHarGh      LaporanHarGh[]
  laporanInspeksiMp LaporanInspeksiMp[]
  laporanHarMp      LaporanHarMp[]
  // Distribution gardu supplied by this penyulang (inverse of Location.supplyFeeder).
  suppliedGardu     Location[]          @relation("GarduSupplyFeeder")

  @@unique([locationId, feederCode], map: "uq_feeder_location_code")
  @@index([locationId], map: "idx_feeders_location")
  @@index([bayId], map: "idx_feeders_bay")
  @@map("feeders")
