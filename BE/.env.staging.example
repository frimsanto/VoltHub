# ─────────────────────────────────────────────────────────────────────────────
# VoltReport Backend — STAGING template
# Copy to `.env` on the staging host (or inject via the deploy pipeline/secret
# manager). Values marked <…> MUST be replaced. NEVER commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production            # staging runs the production build/config path
PORT=3001
API_PREFIX=/api
LOG_LEVEL=info

# Database — dedicated staging DB (do NOT point at production).
DATABASE_URL="mysql://voltreport:<DB_PASSWORD>@db-staging.internal:3306/voltreport_staging"

# JWT — generate distinct strong secrets (e.g. `openssl rand -base64 48`).
# These differ from production so a staging leak can't touch prod tokens.
JWT_SECRET=<STAGING_ACCESS_SECRET_min_32_chars>
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=<STAGING_REFRESH_SECRET_min_32_chars_distinct>
JWT_REFRESH_EXPIRES_IN=30d

# CORS — the staging frontend origin (not "*").
CORS_ORIGIN=https://staging.voltreport.pln.co.id

# Uploads
MAX_FILE_SIZE=26214400
MAX_FILES_PER_UPLOAD=20
UPLOAD_DIR=uploads

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# App version gate
APP_MIN_VERSION=1.0.0
APP_LATEST_VERSION=1.0.0
APP_UPDATE_URL_ANDROID=https://play.google.com/store/apps/details?id=id.pln.voltreport
APP_UPDATE_URL_IOS=https://apps.apple.com/app/voltreport

# Push
FCM_SERVER_KEY=<STAGING_FCM_SERVER_KEY_or_empty>

# Sentry — separate "staging" environment so issues don't mix with production.
SENTRY_DSN=<STAGING_SENTRY_DSN>
SENTRY_ENVIRONMENT=staging
SENTRY_RELEASE=voltreport-backend@1.0.0
SENTRY_TRACES_SAMPLE_RATE=0.2

# Backups
BACKUP_ROOT=/var/backups/voltreport-staging
RETAIN_DAILY=7
RETAIN_WEEKLY=30
RETAIN_MONTHLY=90
