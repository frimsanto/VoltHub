{
  "name": "voltreport-backend",
  "version": "1.0.0",
  "description": "VoltReport Backend API - Express.js with TypeScript, Prisma ORM, MySQL",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts",
    "seed": "tsx prisma/seed.ts",
    "seed:demo": "tsx prisma/seed-demo.ts",
    "seed:demo:clean": "tsx prisma/clean-demo.ts",
    "seed:scada": "tsx prisma/seed-scada.ts",
    "seed:scada:assets": "tsx prisma/seed-scada-assets.ts",
    "seed:scada:laporan": "tsx prisma/seed-scada-laporan.ts",
    "seed:performance": "tsx prisma/seed-performance.ts",
    "reset:roles": "tsx prisma/reset-roles.ts",
    "seed:penyulang": "tsx prisma/seed-penyulang.ts",
    "seed:gardu-penyulang": "tsx prisma/seed-gardu-penyulang.ts",
    "seed:gis-e2e": "tsx prisma/seed-gis-e2e.ts",
    "backfill:gi": "tsx prisma/backfill-gi-rtupp.ts",
    "import:inspeksi-gardu": "tsx prisma/import-inspeksi-gardu.ts",
    "import:har-gardu": "tsx prisma/import-har-gardu.ts",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "express",
    "typescript",
    "prisma",
    "mysql",
    "jwt",
    "rbac"
  ],
  "author": "VoltReport Team",
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "@prisma/client": "^5.10.0",
    "@sentry/node": "^8.55.2",
    "archiver": "^6.0.2",
    "argon2": "^0.45.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.18.3",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.0.1",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pdfkit": "^0.15.2",
    "qrcode": "^1.5.4",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/archiver": "^6.0.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.24",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.39.4",
    "prisma": "^5.10.0",
    "supertest": "^7.2.2",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.60.1",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
